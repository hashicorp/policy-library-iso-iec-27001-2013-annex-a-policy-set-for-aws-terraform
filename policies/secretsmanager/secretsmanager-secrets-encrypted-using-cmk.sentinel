# This policy checks if all secrets in AWS Secrets Manager are encrypted using customer managed keys.
# Refer to https://docs.aws.amazon.com/config/latest/developerguide/secretsmanager-using-cmk.html for more details.

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps
import "strings"

# Parameters
# kmsKeyArns: Optional comma-separated list of KMS key ARNs to check if the keys are used in the encryption
param kmsKeyArns default ""

# Constants
const = {
	"policy_name":                        "secretsmanager-secrets-encrypted-using-cmk",
	"resource_aws_secretsmanager_secret": "aws_secretsmanager_secret",
	"kms_key_id":                         "kms_key_id",
	"aws_managed_key_alias":              "alias/aws/secretsmanager",
}

# Functions
# Parse the comma-separated list of allowed KMS key ARNs
parse_allowed_kms_arns = func(arns_param) {
	if arns_param is "" or arns_param is null {
		return []
	}

	# Split by comma and trim whitespace
	arns_list = strings.split(arns_param, ",")
	allowed_arns = []

	for arns_list as arn {
		trimmed_arn = strings.trim_space(arn)
		if trimmed_arn != "" {
			allowed_arns += [trimmed_arn]
		}
	}

	return allowed_arns
}

# Check if a KMS key ID matches any of the allowed ARNs
is_allowed_kms_key = func(kms_key_id, allowed_arns) {
	# If no specific ARNs are provided, any customer managed key is allowed
	if length(allowed_arns) == 0 {
		return true
	}

	# Check if the kms_key_id matches any of the allowed ARNs
	# The kms_key_id could be an ARN, key ID, or alias
	for allowed_arns as allowed_arn {
		if kms_key_id == allowed_arn {
			return true
		}
		# Also check if the kms_key_id is the key ID portion of the ARN
		if strings.has_suffix(allowed_arn, kms_key_id) {
			return true
		}
	}

	return false
}

generate_violation_message = func(violation, allowed_arns) {
	kms_key_id = maps.get(violation.values, const.kms_key_id, null)

	if kms_key_id is null or kms_key_id is "" {
		return "Secrets Manager secret '" + violation.address + "' must be encrypted with a customer managed KMS key (CMK). The 'kms_key_id' attribute is not specified, which means it uses the AWS managed key (aws/secretsmanager)"
	}

	if kms_key_id == const.aws_managed_key_alias or kms_key_id == "aws/secretsmanager" or strings.has_prefix(kms_key_id, "alias/aws/secretsmanager") {
		return "Secrets Manager secret '" + violation.address + "' is using AWS managed key '" + kms_key_id + "'. The rule is NON_COMPLIANT when using aws/secretsmanager. It must use a customer managed KMS key (CMK) instead"
	}

	if length(allowed_arns) > 0 {
		return "Secrets Manager secret '" + violation.address + "' is using KMS key '" + kms_key_id + "' which is not in the allowed list of KMS key ARNs. Allowed ARNs: " + kmsKeyArns + ""
	}

	return "Secrets Manager secret '" + violation.address + "' must be encrypted with a customer managed KMS key (CMK)"
}

# Variables
allowed_kms_arns = parse_allowed_kms_arns(kmsKeyArns)
resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_secretsmanager_secret).resources

violations = filter resources as _, res {
	maps.get(res.values, const.kms_key_id, null) is null or
		maps.get(res.values, const.kms_key_id, null) is "" or
		maps.get(res.values, const.kms_key_id, "") == const.aws_managed_key_alias or
		maps.get(res.values, const.kms_key_id, "") == "aws/secretsmanager" or
		strings.has_prefix(maps.get(res.values, const.kms_key_id, ""), "alias/aws/secretsmanager") or
		(length(allowed_kms_arns) > 0 and not is_allowed_kms_key(maps.get(res.values, const.kms_key_id, ""), allowed_kms_arns))
}

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v, allowed_kms_arns),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
