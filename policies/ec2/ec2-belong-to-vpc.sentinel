# This policy verifies that EC2 instances belong to a virtual private cloud (VPC) by checking if the vpc_id or subnet_id is defined for aws_instance resources.

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps
import "strings"

# Parameters
param vpcId default ""

# Constants
const = {
	"policy_name":   "ec2-belong-to-vpc",
	"resource_type": "aws_instance",
}

# Functions
generate_violation_message = func(violation, reason) {
	base_message = "EC2 instance must belong to a VPC. "
	return base_message + reason + " Refer to https://docs.aws.amazon.com/config/latest/developerguide/ec2-instances-in-vpc.html for more details."
}

# Helper function to check if a VPC ID matches the parameter
matches_vpc_id_param = func(vpc_id, vpc_id_param) {
	# If no vpcId parameter is specified, accept any VPC
	if vpc_id_param is "" or vpc_id_param is null {
		return true
	}

	# Direct match
	if vpc_id is vpc_id_param {
		return true
	}

	# Check if the vpc_id contains the parameter (for partial matches or references)
	if strings.has_prefix(vpc_id, "${") and strings.has_suffix(vpc_id, "}") {
		# This is a Terraform reference, check if it contains the parameter
		if vpc_id contains vpc_id_param {
			return true
		}
	}

	return false
}

# Check if network_interface block is properly configured
is_network_interface_valid = func(network_interface) {
	if network_interface is null or network_interface is [] {
		return false
	}

	# Check each network interface in the array
	for network_interface as ni {
		# Must have network_interface_id
		ni_id = maps.get(ni, "network_interface_id", "")
		if ni_id is null or ni_id is "" {
			return false
		}

		# device_index is required
		device_index = maps.get(ni, "device_index", null)
		if device_index is null {
			return false
		}

		# delete_on_termination should be false (only valid value currently)
		delete_on_termination = maps.get(ni, "delete_on_termination", false)
		if delete_on_termination is not false {
			return false
		}
	}

	return true
}

# Check if primary_network_interface is properly configured
is_primary_network_interface_valid = func(primary_network_interface) {
	if primary_network_interface is null or primary_network_interface is [] {
		return false
	}

	# For primary_network_interface, check if it has network_interface_id
	if length(primary_network_interface) > 0 {
		pni = primary_network_interface[0]
		ni_id = maps.get(pni, "network_interface_id", "")
		return ni_id is not null and ni_id is not ""
	}

	return false
}

is_instance_in_vpc = func(res, vpc_id_param) {
	# Check if vpc_id is defined and not empty
	vpc_id = maps.get(res.values, "vpc_id", "")
	vpc_id_defined = vpc_id is not null and vpc_id is not ""

	# If vpc_id is defined, check if it matches the parameter
	if vpc_id_defined {
		if not matches_vpc_id_param(vpc_id, vpc_id_param) {
			return {
				"compliant": false,
				"reason":    "Instance vpc_id '" + vpc_id + "' does not match required VPC ID '" + vpc_id_param + "'.",
			}
		}
		return {
			"compliant": true,
			"reason":    "",
		}
	}

	# Check if subnet_id is defined and not empty
	subnet_id = maps.get(res.values, "subnet_id", "")
	subnet_id_defined = subnet_id is not null and subnet_id is not ""

	# Check if network_interface_id is defined and not empty (deprecated single interface)
	network_interface_id = maps.get(res.values, "network_interface_id", "")
	network_interface_id_defined = network_interface_id is not null and network_interface_id is not ""

	# Check if vpc_security_group_ids is defined and not empty (indicates VPC membership)
	vpc_security_group_ids = maps.get(res.values, "vpc_security_group_ids", null)
	vpc_sg_defined = vpc_security_group_ids is not null and vpc_security_group_ids is not []

	# Check if primary_network_interface is defined and valid (recommended approach)
	primary_network_interface = maps.get(res.values, "primary_network_interface", null)
	primary_ni_valid = is_primary_network_interface_valid(primary_network_interface)

	# Check if network_interface array is defined and valid (deprecated approach)
	network_interface = maps.get(res.values, "network_interface", null)
	network_interface_valid = is_network_interface_valid(network_interface)

	# Instance is in VPC if any of these attributes are defined
	in_vpc = subnet_id_defined or network_interface_id_defined or vpc_sg_defined or primary_ni_valid or network_interface_valid

	if not in_vpc {
		return {
			"compliant": false,
			"reason":    "Instance does not have a vpc_id, subnet_id, network_interface_id, vpc_security_group_ids, primary_network_interface, or valid network_interface defined.",
		}
	}

	# If vpcId parameter is specified but we can't verify it (no direct vpc_id),
	# we still pass since the instance is in a VPC (just can't verify which one)
	return {
		"compliant": true,
		"reason":    "",
	}
}

# Variables
resources = tf.plan(tfplan.planned_values.resources).type(const.resource_type).resources

# Check each resource and collect violations with detailed reasons
violations = []
for resources as _, res {
	result = is_instance_in_vpc(res, vpcId)
	if not result.compliant {
		violations += [{
			"address":        res.address,
			"module_address": res.module_address,
			"reason":         result.reason,
		}]
	}
}

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v, v.reason),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
