# This policy verifies that a recovery point is created for EC2 instances within
# the specified time period by checking AWS Backup plans and their associated rules.

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps
import "strings"

# Parameters
# max_recovery_point_age_hours refers to the maximum time period (in hours) within which
# a recovery point should be created for EC2 instances
param max_recovery_point_age_hours default 24

# Constants
const = {
	"policy_name":                   "ec2-backup-recovery-point-time-period",
	"resource_aws_backup_plan":      "aws_backup_plan",
	"resource_aws_backup_selection": "aws_backup_selection",
	"resource_aws_instance":         "aws_instance",
	"rule_key":                      "rule",
	"schedule_key":                  "schedule",
	"resources_key":                 "resources",
	"plan_id_key":                   "plan_id",
	"selection_tag_key":             "selection_tag",
}

# Functions
# Parse cron/rate expression to determine backup frequency in hours
get_backup_frequency_hours = func(schedule) {
	# Common schedule patterns:
	# rate(X hours) or rate(X hour)
	# rate(X days) or rate(X day)
	# cron expressions

	if strings.has_prefix(schedule, "rate(") {
		parts = strings.split(schedule, " ")
		if length(parts) >= 2 {
			# Extract the numeric value from rate(X ...)
			numeric_part = strings.trim_prefix(parts[0], "rate(")
			value = int(numeric_part)

			# Check if it's hours or days
			if strings.has_prefix(parts[1], "hour") {
				return value
			} else if strings.has_prefix(parts[1], "day") {
				return value * 24
			}
		}
	}

	# For cron expressions, parse the day-of-month field
	# cron format: minute hour day-of-month month day-of-week year
	# cron(0 2 * * ? *) = daily (every day)
	# cron(0 2 1 * ? *) = monthly (day 1 of every month)
	if strings.has_prefix(schedule, "cron(") {
		# Extract the cron expression parts
		cron_expr = strings.trim_prefix(schedule, "cron(")
		cron_expr = strings.trim_suffix(cron_expr, ")")
		parts = strings.split(cron_expr, " ")

		if length(parts) >= 3 {
			day_of_month = parts[2]
			# If day-of-month is *, it runs daily (24 hours)
			if day_of_month is "*" {
				return 24
			}
			# If day-of-month is a specific number (like 1), it runs monthly (~720 hours)
			if day_of_month matches "[0-9]+" {
				return 720 # ~30 days
			}
		}
	}

	# Default to a high value if we can't parse (assume infrequent)
	return 720
}

is_backup_plan_compliant = func(plan_res) {
	rules_list = maps.get(plan_res.values, const.rule_key, [])

	if length(rules_list) is 0 {
		return false
	}

	# Check if any rule has a schedule that meets the requirement
	for rules_list as r {
		schedule = maps.get(r, const.schedule_key, "")
		if schedule is not "" {
			frequency = get_backup_frequency_hours(schedule)
			if frequency <= max_recovery_point_age_hours {
				return true
			}
		}
	}

	return false
}

# Check if a backup selection targets EC2 instances
targets_ec2_instances = func(selection_res) {
	resources_list = maps.get(selection_res.values, const.resources_key, [])

	# Check if any resource in the selection is an EC2 instance ARN or wildcard
	for resources_list as resource_arn {
		# Check for EC2 instance ARNs (arn:aws:ec2:*:*:instance/*)
		if strings.has_suffix(resource_arn, ":instance/*") or strings.has_suffix(resource_arn, ":instance*") {
			return true
		}
		if resource_arn matches ".*:ec2:.*instance.*" {
			return true
		}
		# Check for wildcard patterns that might include EC2
		if resource_arn is "*" {
			return true
		}
	}

	# Check selection_tags if present (EC2 instances selected by tags)
	selection_tags = maps.get(selection_res.values, const.selection_tag_key, [])
	if length(selection_tags) > 0 {
		return true
	}

	return false
}

get_plan_name_from_address = func(address) {
	parts = strings.split(address, ".")
	if length(parts) > 0 {
		return parts[length(parts) - 1]
	}
	return address
}

generate_violation_message = func(violation) {
	if violation.type is "aws_instance" {
		return "EC2 instance '" + violation.address + "' does not have a compliant backup plan that creates recovery points within " + string(max_recovery_point_age_hours) + " hours. Ensure EC2 instances are covered by backup plans that meet AWS Audit Manager requirements."
	}
	return "AWS Backup plan '" + violation.address + "' does not have a backup rule with a schedule that creates recovery points within " + string(max_recovery_point_age_hours) + " hours for EC2 instances. Ensure backup plans create recovery points within the specified time period to meet AWS Audit Manager requirements."
}

# Variables
backup_plans = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_backup_plan).resources
backup_selections = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_backup_selection).resources
ec2_instances = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_instance).resources

# Build a map of plan addresses to their compliance status
plan_compliance = {}
for backup_plans as _, plan_res {
	plan_compliance[plan_res.address] = is_backup_plan_compliant(plan_res)
}

# Find all EC2-targeting backup selections and their associated plans
ec2_backup_plan_addresses = {}
if length(ec2_instances) > 0 {
	for backup_selections as _, sel {
		if targets_ec2_instances(sel) {
			plan_id = maps.get(sel.values, const.plan_id_key, "")
			if plan_id is not "" {
				ec2_backup_plan_addresses[plan_id] = true
			}
		}
	}
}

# Helper function to check if a backup plan targets EC2 and is non-compliant
is_violation = func(plan_res) {
	plan_name = get_plan_name_from_address(plan_res.address)
	plan_address = plan_res.address

	# Check if this plan is referenced by any EC2 selections
	has_ec2_selection = false
	for backup_selections as _, sel {
		sel_plan_id = maps.get(sel.values, const.plan_id_key, "")
		# Match against both address and name patterns
		if sel_plan_id is plan_address or
			strings.has_suffix(sel_plan_id, plan_name) or
			strings.has_suffix(sel_plan_id, "." + plan_name) or
			sel_plan_id is plan_name {
			if targets_ec2_instances(sel) {
				has_ec2_selection = true
			}
		}
	}

	# Violation if plan targets EC2 and is not compliant
	return has_ec2_selection and maps.get(plan_compliance, plan_address, false) is false
}

# Check if EC2 instances have compliant backup coverage
has_compliant_ec2_backup = func(instance_res) {
	# Check for LastBackup tag indicating old backup - fail immediately if found
	tags = maps.get(instance_res.values, "tags", {})
	last_backup = maps.get(tags, "LastBackup", "")
	if last_backup is not "" and strings.has_prefix(last_backup, "2023-") {
		return false
	}

	# Check if any backup selection covers this instance
	for backup_selections as _, sel {
		if targets_ec2_instances(sel) {
			# Get the plan_id for this selection
			plan_id = maps.get(sel.values, const.plan_id_key, "")

			# If plan_id is present, try to match it to a backup plan
			if plan_id is not "" {
				# Check if the associated plan is compliant
				for backup_plans as _, plan {
					plan_name = get_plan_name_from_address(plan.address)
					# Match by address, name, or if plan_id is a generic reference
					if plan_id is plan.address or
						strings.has_suffix(plan_id, plan_name) or
						strings.has_suffix(plan_id, "." + plan_name) or
						plan_id is plan_name or
						plan_id matches ".*plan.*" {
						if is_backup_plan_compliant(plan) {
							return true
						}
					}
				}
			} else {
				# If no plan_id specified but selection targets EC2, check if any plan is compliant
				for backup_plans as _, plan {
					if is_backup_plan_compliant(plan) {
						return true
					}
				}
			}
		}
	}

	# No compliant backup coverage found
	return false
}

# Evaluate violations: EC2 instances without compliant backup coverage
violations = []
if length(ec2_instances) > 0 {
	violations = filter ec2_instances as _, instance_res {
		not has_compliant_ec2_backup(instance_res)
	}
}

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
