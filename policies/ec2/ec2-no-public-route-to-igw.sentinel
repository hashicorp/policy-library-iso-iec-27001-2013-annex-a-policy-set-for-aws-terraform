# This policy checks if there are public routes in the route table to an Internet Gateway (IGW)
# with unrestricted access (0.0.0.0/0 or ::/0).
# Refer to https://docs.aws.amazon.com/config/latest/developerguide/no-unrestricted-route-to-igw.html for more details.

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfconfig/v2" as tfconfig
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps
import "strings"

# Parameters
param routeTableIds default ""

# Constants
const = {
	"policy_name":       "ec2-no-public-route-to-igw",
	"route_table_type":  "aws_route_table",
	"cidr_block":        "cidr_block",
	"ipv6_cidr_block":   "ipv6_cidr_block",
	"gateway_id":        "gateway_id",
	"unrestricted_ipv4": "0.0.0.0/0",
	"unrestricted_ipv6": "::/0",
}

# Functions
parse_allowed_route_table_ids = func() {
	if routeTableIds is "" {
		return []
	}
	# Split by comma and trim whitespace
	ids = strings.split(routeTableIds, ",")
	trimmed_ids = []
	for ids as id {
		trimmed_id = strings.trim_space(id)
		if trimmed_id != "" {
			trimmed_ids += [trimmed_id]
		}
	}
	return trimmed_ids
}

is_internet_gateway = func(gateway_id) {
	# Check if gateway_id is empty, null, or undefined
	if gateway_id else "" is "" {
		return false
	}
	return strings.has_prefix(gateway_id, "igw-")
}

is_route_table_allowed = func(route_table_id, allowed_ids) {
	# If no allowed IDs specified, all route tables are subject to the policy
	if length(allowed_ids) is 0 {
		return false
	}

	# Check if this route table ID is in the allowed list
	for allowed_ids as allowed_id {
		if route_table_id is allowed_id {
			return true
		}
	}
	return false
}

get_route_blocks = func(route_table_res) {
	route_cfg = maps.get(route_table_res, "config.route", null)
	if route_cfg is null {
		return []
	}

	route_const = maps.get(route_table_res, "config.route.constant_value", null)
	if route_const is not null {
		return route_const
	}

	return route_cfg
}

get_route_attr = func(route, key) {
	attr = maps.get(route, key, "")
	attr_const = maps.get(route, key + ".constant_value", null)
	if attr_const is not null {
		return attr_const
	}
	return attr
}

check_route_table_routes = func(route_table_res, allowed_ids) {
	# Get the route table ID from config if available; fallback to address.
	route_table_id = maps.get(route_table_res, "config.id.constant_value", route_table_res.address)

	# If this route table is in the allowed list, skip validation
	if is_route_table_allowed(route_table_id, allowed_ids) {
		return false
	}

	routes = get_route_blocks(route_table_res)

	for routes as route {
		gateway_id = get_route_attr(route, const.gateway_id)
		cidr = get_route_attr(route, const.cidr_block)
		ipv6_cidr = get_route_attr(route, const.ipv6_cidr_block)

		if is_internet_gateway(gateway_id) and (cidr is const.unrestricted_ipv4 or ipv6_cidr is const.unrestricted_ipv6) {
			return true
		}
	}

	return false
}

generate_route_table_violation_message = func(violation) {
	route_table_id = maps.get(violation, "config.id.constant_value", violation.address)
	return "Route table '" + route_table_id + "' contains routes with unrestricted access (0.0.0.0/0 or ::/0) to an Internet Gateway. This creates public routes with unrestricted access"
}

# Variables
allowed_route_table_ids = parse_allowed_route_table_ids()
route_table_resources = tf.config(tfconfig.resources).type(const.route_table_type).resources

# Check aws_route_table resources with inline route blocks
route_table_violations = filter route_table_resources as _, res {
	check_route_table_routes(res, allowed_route_table_ids) is true
}

# Build violations list
all_violations = []
for route_table_violations as _, v {
	all_violations += [{
		"address":        v.address else "",
		"module_address": v.module_address else "",
		"message":        generate_route_table_violation_message(v),
	}]
}

summary = {
	"policy_name": const.policy_name,
	"violations":  all_violations,
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	all_violations is empty
}
