resources = {
	"aws_ebs_volume.example": {
		"address": "aws_ebs_volume.example",
		"config": {
			"arn": {
				"constant_value": "arn:aws:ec2:us-east-1:123456789012:volume/vol-33333333",
			},
			"availability_zone": {
				"constant_value": "us-east-1c",
			},
			"encrypted": {
				"constant_value": true,
			},
			"id": {
				"constant_value": "vol-33333333",
			},
			"size": {
				"constant_value": 150,
			},
			"tags": {
				"constant_value": {
					"Backup":      "true",
					"Environment": "prod-app",
				},
			},
			"type": {
				"constant_value": "gp3",
			},
		},
		"count":               {},
		"depends_on":          [],
		"for_each":            {},
		"mode":                "managed",
		"module_address":      "",
		"name":                "example",
		"provider_config_key": "aws",
		"provisioners":        [],
		"type":                "aws_ebs_volume",
	},
	"aws_backup_selection.example": {
		"address": "aws_backup_selection.example",
		"config": {
			"condition": [
				{
					"string_equals": [
						{
							"key": {
								"constant_value": "aws:ResourceTag/Backup",
							},
							"value": {
								"constant_value": "true",
							},
						},
					],
					"string_like": [
						{
							"key": {
								"constant_value": "aws:ResourceTag/Environment",
							},
							"value": {
								"constant_value": "prod*",
							},
						},
					],
				},
			],
			"iam_role_arn": {
				"constant_value": "arn:aws:iam::123456789012:role/aws-backup-role",
			},
			"name": {
				"constant_value": "condition-selection",
			},
			"plan_id": {
				"references": [
					"aws_backup_plan.example.id",
					"aws_backup_plan.example",
				],
			},
			"resources": {
				"constant_value": ["*"],
			},
		},
		"count":               {},
		"depends_on":          [],
		"for_each":            {},
		"mode":                "managed",
		"module_address":      "",
		"name":                "example",
		"provider_config_key": "aws",
		"provisioners":        [],
		"type":                "aws_backup_selection",
	},
	"aws_backup_plan.example": {
		"address": "aws_backup_plan.example",
		"config": {
			"name": {
				"constant_value": "condition-plan",
			},
			"rule": [
				{
					"rule_name": {
						"constant_value": "six-hour-backup",
					},
					"schedule": {
						"constant_value": "rate(6 hours)",
					},
					"target_vault_name": {
						"constant_value": "Default",
					},
				},
			],
		},
		"count":               {},
		"depends_on":          [],
		"for_each":            {},
		"mode":                "managed",
		"module_address":      "",
		"name":                "example",
		"provider_config_key": "aws",
		"provisioners":        [],
		"type":                "aws_backup_plan",
	},
}
