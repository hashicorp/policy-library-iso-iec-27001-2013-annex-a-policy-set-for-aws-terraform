# This policy ensures that non-default security groups are attached to elastic network interfaces.
# Elastic network interfaces should not use default security groups as they typically have overly permissive rules.

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps
import "strings"

# Constants
const = {
	"policy_name":                    "ec2-non-default-security-groups-attached-to-eni",
	"resource_aws_network_interface": "aws_network_interface",
	"security_groups":                "security_groups",
	"message":                        "Elastic network interfaces should be attached to non-default security groups. Refer to AWS Audit Manager best practices for more details.",
}

# Functions
is_default_security_group = func(sg) {
	sg_string = string(sg)
	return strings.has_suffix(sg_string, "default") or
		sg_string matches ".*/default$" or
		sg_string is "default"
}

has_non_default_security_groups = func(res) {
	sg_list = maps.get(res.values, const.security_groups, [])

	# If no security groups are specified, it's a violation
	if length(sg_list) is 0 {
		return false
	}

	# Check if any security group is default
	default_sgs = filter sg_list as _, sg {
		is_default_security_group(sg)
	}

	# If any default security groups are found, it's a violation
	if length(default_sgs) > 0 {
		return false
	}

	# All security groups are non-default
	return true
}

generate_violation_message = func(violation) {
	sg_list = maps.get(violation.values, const.security_groups, [])
	if length(sg_list) is 0 {
		return "Network interface '" + violation.address + "' has no security groups attached. " + const.message
	}

	default_sgs = filter sg_list as _, sg {
		is_default_security_group(sg)
	}

	if length(default_sgs) > 0 {
		return "Network interface '" + violation.address + "' is attached to default security group(s). " + const.message
	}

	return "Network interface '" + violation.address + "' must use non-default security groups. " + const.message
}

# Variables
resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_network_interface).resources
violations = collection.reject(resources, func(res) {
	return has_non_default_security_groups(res)
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
