# This policy verifies that internet gateways are only attached to authorized VPCs. The rule is NON_COMPLIANT if internet gateways are attached to unauthorized VPCs.

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfconfig/v2" as tfconfig
import "tfresources" as tf
import "report" as report
import "collection/maps" as maps
import "strings"

# Parameters
# authorized_vpc_ids is a comma-separated list of VPC IDs that are authorized to have internet gateways attached
param authorized_vpc_ids default ""

# Constants
const = {
	"policy_name":                              "ec2-internet-gateway-allow-authorized-vpc-only",
	"resource_aws_internet_gateway":            "aws_internet_gateway",
	"resource_aws_internet_gateway_attachment": "aws_internet_gateway_attachment",
	"vpc_id":                                   "vpc_id",
}

# Parse the CSV parameter into a list and trim whitespace
parse_authorized_vpc_ids = func(csv_string) {
	if length(csv_string) is 0 {
		return []
	}

	vpc_list = strings.split(csv_string, ",")
	trimmed_list = []

	for vpc_list as vpc {
		trimmed_list = trimmed_list + [strings.trim_space(vpc)]
	}

	return trimmed_list
}

trimmed_authorized_vpc_ids = parse_authorized_vpc_ids(authorized_vpc_ids)

# Functions
generate_violation_message = func(violation) {
	vpc_id = violation.vpc_id
	if length(trimmed_authorized_vpc_ids) is 0 {
		return "Internet gateway '" + violation.address + "' is attached to VPC '" + string(vpc_id) + "'. No authorized VPCs are configured. Please configure the 'authorized_vpc_ids' parameter with a comma-separated list of authorized VPC IDs. Refer to https://docs.aws.amazon.com/config/latest/developerguide/internet-gateway-authorized-vpc-only.html for more details."
	}
	return "Internet gateway '" + violation.address + "' is attached to unauthorized VPC '" + string(vpc_id) + "'. Authorized VPCs are: " + string(trimmed_authorized_vpc_ids) + ". Refer to https://docs.aws.amazon.com/config/latest/developerguide/internet-gateway-authorized-vpc-only.html for more details."
}

# Helper function to check if a VPC ID matches the authorized list
is_vpc_authorized = func(vpc_id) {
	# If vpc_id is not defined, consider it non-compliant
	if vpc_id is null or vpc_id is "" {
		return false
	}

	# If no authorized VPCs are configured, consider all VPCs unauthorized
	if length(trimmed_authorized_vpc_ids) is 0 {
		return false
	}

	# Check if the VPC ID is in the authorized list
	for trimmed_authorized_vpc_ids as authorized_vpc_id {
		if vpc_id is authorized_vpc_id {
			return true
		}
	}

	return false
}

# Helper function to get VPC ID from config
get_vpc_id_from_config = func(res_config) {
	vpc_id_config = maps.get(res_config, "config.vpc_id", null)
	if vpc_id_config is null {
		return null
	}

	# Check if it has a constant value (hardcoded VPC ID)
	constant_value = maps.get(vpc_id_config, "constant_value", null)
	if constant_value is not null and constant_value is not "" {
		return constant_value
	}

	# Check if it has references (resource references)
	# References cannot be validated at config time since the actual VPC ID is only known after apply
	references = maps.get(vpc_id_config, "references", [])
	if references is not empty {
		vpc_ref = references[0]
		return "reference:" + vpc_ref
	}

	return null
}

# Check if internet gateway is attached to authorized VPC
check_igw_vpc = func(res_config) {
	vpc_id = get_vpc_id_from_config(res_config)
	
	if vpc_id is null {
		return {
			"compliant": false,
			"vpc_id":    "undefined",
		}
	}

	# If it's still a reference (couldn't resolve), treat as non-compliant
	if strings.has_prefix(vpc_id, "reference:") {
		ref = strings.trim_prefix(vpc_id, "reference:")
		return {
			"compliant": false,
			"vpc_id":    ref,
		}
	}

	# Check if the VPC ID is authorized
	if is_vpc_authorized(vpc_id) {
		return {
			"compliant": true,
			"vpc_id":    vpc_id,
		}
	}

	return {
		"compliant": false,
		"vpc_id":    vpc_id,
	}
}

# Variables
igw_config_resources = tf.config(tfconfig.resources).type(const.resource_aws_internet_gateway).resources
igw_attachment_config_resources = tf.config(tfconfig.resources).type(const.resource_aws_internet_gateway_attachment).resources

# Check violations for aws_internet_gateway resources
# Only check IGWs that have a vpc_id attribute (inline attachment)
# IGWs without vpc_id use separate aws_internet_gateway_attachment resources
violations = []
for igw_config_resources as _, res_config {
	vpc_id_config = maps.get(res_config, "config.vpc_id", null)
	# Skip IGWs without vpc_id (they use separate attachment resources)
	if vpc_id_config is not null {
		result = check_igw_vpc(res_config)
		if not result.compliant {
			violations += [{
				"address":        res_config.address,
				"module_address": res_config.module_address,
				"vpc_id":         result.vpc_id,
			}]
		}
	}
}

# Check violations for aws_internet_gateway_attachment resources
for igw_attachment_config_resources as _, res_config {
	result = check_igw_vpc(res_config)
	if not result.compliant {
		violations += [{
			"address":        res_config.address,
			"module_address": res_config.module_address,
			"vpc_id":         result.vpc_id,
		}]
	}
}

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
