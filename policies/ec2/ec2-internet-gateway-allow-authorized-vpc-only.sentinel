# This policy verifies that internet gateways are only attached to authorized VPCs. The rule is NON_COMPLIANT if internet gateways are attached to unauthorized VPCs.

# Copyright IBM Corp. 2024, 2025
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps

# Parameters
# authorized_vpc_ids is a list of VPC IDs that are authorized to have internet gateways attached
param authorized_vpc_ids default []

# Constants
const = {
	"policy_name":                             "ec2-internet-gateway-allow-authorized-vpc-only",
	"resource_aws_internet_gateway":           "aws_internet_gateway",
	"resource_aws_internet_gateway_attachment": "aws_internet_gateway_attachment",
	"vpc_id":                                  "vpc_id",
}

# Functions
generate_violation_message = func(violation) {
	vpc_id = maps.get(violation.values, const.vpc_id, "undefined")
	if length(authorized_vpc_ids) is 0 {
		return "Internet gateway '" + violation.address + "' is attached to VPC '" + string(vpc_id) + "'. No authorized VPCs are configured. Please configure the 'authorized_vpc_ids' parameter with a list of authorized VPC IDs. Refer to https://docs.aws.amazon.com/config/latest/developerguide/internet-gateway-authorized-vpc-only.html for more details."
	}
	return "Internet gateway '" + violation.address + "' is attached to unauthorized VPC '" + string(vpc_id) + "'. Authorized VPCs are: " + string(authorized_vpc_ids) + ". Refer to https://docs.aws.amazon.com/config/latest/developerguide/internet-gateway-authorized-vpc-only.html for more details."
}

is_vpc_authorized = func(res) {
	vpc_id = maps.get(res.values, const.vpc_id, null)
	
	# If vpc_id is not defined, consider it non-compliant
	if vpc_id is null {
		return false
	}
	
	# If no authorized VPCs are configured, consider all VPCs unauthorized
	if length(authorized_vpc_ids) is 0 {
		return false
	}
	
	# Check if the VPC ID is in the authorized list
	for authorized_vpc_ids as authorized_vpc_id {
		if vpc_id is authorized_vpc_id {
			return true
		}
	}
	
	return false
}

# Variables
igw_resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_internet_gateway).resources
igw_attachment_resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_internet_gateway_attachment).resources

# Check violations for both resource types
igw_violations = collection.reject(igw_resources, func(res) {
	return is_vpc_authorized(res)
})

igw_attachment_violations = collection.reject(igw_attachment_resources, func(res) {
	return is_vpc_authorized(res)
})

# Combine violations from both resource types
violations = {}
for igw_violations as address, resource {
	violations[address] = resource
}
for igw_attachment_violations as address, resource {
	violations[address] = resource
}

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
