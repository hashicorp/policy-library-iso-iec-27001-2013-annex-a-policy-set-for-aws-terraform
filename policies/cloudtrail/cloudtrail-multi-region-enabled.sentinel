# This policy ensures that there is at least one multi-region AWS CloudTrail Event Data Store that includes management events and does not exclude KMS or RDS Data API events.

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection/maps" as maps
import "strings"

# Parameters
param s3_bucket_name default ""
param sns_topic_arn default ""
param cloudwatch_logs_log_group_arn default ""
param include_management_events default true
param read_write_type default "All"

# Constants
const = {
	"policy_name":             "cloudtrail-multi-region-enabled",
	"resource_cloudtrail":     "aws_cloudtrail_event_data_store",
	"multi_region_enabled":    "multi_region_enabled",
	"advanced_event_selector": "advanced_event_selector",
	"field_selector":          "field_selector",
}

# Functions
matches_read_write_type = func(selector_read_write_type) {
	# If no read_write_type parameter specified or empty, accept all
	if read_write_type is "" or read_write_type is "All" {
		return true
	}

	# Normalize to lowercase for comparison
	param_type = strings.to_lower(read_write_type)
	selector_type = strings.to_lower(selector_read_write_type)

	# "All" matches everything
	if param_type is "all" {
		return true
	}

	# Check if selector matches parameter
	return selector_type is param_type or selector_type is "all"
}

is_multi_region_compliant = func(res) {
	# Check if multi-region is enabled
	is_multi_region = maps.get(res.values, const.multi_region_enabled, false)

	if is_multi_region is not true {
		return false
	}

	# Check optional parameters if specified (non-empty)
	if s3_bucket_name is not "" {
		bucket = maps.get(res.values, "s3_bucket_name", "")
		if bucket is not s3_bucket_name {
			return false
		}
	}

	if sns_topic_arn is not "" {
		topic = maps.get(res.values, "sns_topic_arn", "")
		if topic is not sns_topic_arn {
			return false
		}
	}

	if cloudwatch_logs_log_group_arn is not "" {
		log_group = maps.get(res.values, "cloudwatch_logs_log_group_arn", "")
		if log_group is not cloudwatch_logs_log_group_arn {
			return false
		}
	}

	# Check advanced event selectors for management events
	advanced_event_selectors = maps.get(res.values, const.advanced_event_selector, [])

	# If no advanced event selectors are defined
	if length(advanced_event_selectors) is 0 {
		# If include_management_events parameter is not specified or true, default behavior includes management events
		# If include_management_events is false, we accept it as compliant (no selectors means default behavior)
		return true
	}

	# Check each advanced event selector
	for advanced_event_selectors as adv_selector {
		field_selectors = maps.get(adv_selector, const.field_selector, [])
		selector_name = maps.get(adv_selector, "name", "")

		# Check if this selector includes management events
		has_management_category = false
		excludes_kms = false
		excludes_rds = false
		selector_read_write = "All"

		for field_selectors as field {
			field_name = maps.get(field, "field", "")

			# Check if eventCategory equals Management
			if field_name is "eventCategory" {
				equals_list = maps.get(field, "equals", [])
				for equals_list as val {
					if val is "Management" {
						has_management_category = true
					}
				}
			}

			# Check readWriteType
			if field_name is "readWriteType" {
				equals_list = maps.get(field, "equals", [])
				if length(equals_list) > 0 {
					selector_read_write = equals_list[0]
				}
			}

			# Check if eventSource excludes KMS or RDS
			if field_name is "eventSource" {
				not_equals_list = maps.get(field, "not_equals", [])
				for not_equals_list as val {
					if val is "kms.amazonaws.com" {
						excludes_kms = true
					}
					if val is "rdsdata.amazonaws.com" {
						excludes_rds = true
					}
				}
			}
		}

		# Check if this selector meets all requirements
		if include_management_events is true {
			# When include_management_events is true, we require management events without KMS/RDS exclusions
			if has_management_category is true and
				excludes_kms is false and
				excludes_rds is false and
				matches_read_write_type(selector_read_write) {
				return true
			}
		} else {
			# When include_management_events is false, we accept any selector that matches readWriteType
			# and doesn't have management events, OR has management events without exclusions
			if matches_read_write_type(selector_read_write) {
				# Accept if no management events, or if management events without KMS/RDS exclusions
				if has_management_category is false or (excludes_kms is false and excludes_rds is false) {
					return true
				}
			}
		}
	}

	return false
}

has_compliant_trail = func(resources) {
	if length(resources) is 0 {
		return false
	}

	for resources as _, res {
		if is_multi_region_compliant(res) is true {
			return true
		}
	}

	return false
}

# Variables
cloudtrail_resources = tf.plan(tfplan.planned_values.resources).type(const.resource_cloudtrail).resources
violations = []

# Check if there is at least one compliant multi-region trail
if has_compliant_trail(cloudtrail_resources) is false {
	violations = [{
		"address":        "global",
		"module_address": "",
		"message":        "At least one multi-region AWS CloudTrail Event Data Store must be configured with management events enabled and without excluding KMS or RDS Data API events. Refer to https://registry.terraform.io/providers/hashicorp/aws/latest/docs/resources/cloudtrail_event_data_store for more details.",
	}]
}

summary = {
	"policy_name": const.policy_name,
	"violations":  violations,
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
