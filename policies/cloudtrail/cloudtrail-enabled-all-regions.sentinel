# This policy ensures that AWS CloudTrail is enabled in all regions by checking
# that the is_multi_region_trail attribute is set to true for aws_cloudtrail resources.

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps

# Constants
const = {
	"policy_name":             "cloudtrail-enabled-all-regions",
	"resource_aws_cloudtrail": "aws_cloudtrail",
	"is_multi_region_trail":   "is_multi_region_trail",
	"enable_logging":          "enable_logging",
}

# Functions
generate_violation_message = func(violation) {
	is_multi_region = maps.get(violation.values, const.is_multi_region_trail, false)
	enable_logging = maps.get(violation.values, const.enable_logging, true)

	if is_multi_region is false and enable_logging is false {
		return "CloudTrail '" + violation.address + "' must have 'is_multi_region_trail' set to true and 'enable_logging' set to true. Refer to AWS Audit Manager best practices for more details."
	} else if is_multi_region is false {
		return "CloudTrail '" + violation.address + "' must have 'is_multi_region_trail' set to true to enable logging in all regions. Refer to AWS Audit Manager best practices for more details."
	} else {
		return "CloudTrail '" + violation.address + "' must have 'enable_logging' set to true. Refer to AWS Audit Manager best practices for more details."
	}
}

# Variables
resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_cloudtrail).resources

violations = collection.reject(resources, func(res) {
	is_multi_region = maps.get(res.values, const.is_multi_region_trail, false)
	enable_logging = maps.get(res.values, const.enable_logging, true)
	return is_multi_region is true and enable_logging is true
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
