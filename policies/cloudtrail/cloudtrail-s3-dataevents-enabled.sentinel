# This policy verifies that at least one AWS CloudTrail trail is logging
# Amazon S3 data events for all S3 buckets.
# Refer to https://docs.aws.amazon.com/config/latest/developerguide/cloudtrail-s3-dataevents-enabled.html for more details.

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection/maps" as maps
import "strings"

# Params
# S3BucketNames (Optional)
# Type: String
# Comma-separated list of S3 bucket names for which data events logging should be enabled.
# Default behavior checks for all S3 buckets.
param S3BucketNames default ""

# Constants
const = {
	"policy_name":             "cloudtrail-s3-dataevents-enabled",
	"message":                 "At least one AWS CloudTrail trail must be logging Amazon S3 data events for all S3 buckets",
	"resource_aws_cloudtrail": "aws_cloudtrail",
	"ends_with":               "ends_with",
	"event_selector":          "event_selector",
	"advanced_event_selector": "advanced_event_selector",
	"data_resource":           "data_resource",
	"field_selector":          "field_selector",
	"type":                    "type",
	"values":                  "values",
	"field":                   "field",
	"equals":                  "equals",
	"not_ends_with":           "not_ends_with",
	"not_equals":              "not_equals",
	"not_starts_with":         "not_starts_with",
	"s3_resource_type":        "AWS::S3::Object",
	"starts_with":             "starts_with",
}

# Functions
# Parse comma-separated list of S3 bucket names
get_target_bucket_names = func() {
	if S3BucketNames is "" {
		return []
	}

	# Split by comma and trim whitespace
	buckets = strings.split(S3BucketNames, ",")
	trimmed_buckets = []
	for buckets as bucket {
		trimmed = strings.trim_space(bucket)
		if trimmed is not "" {
			trimmed_buckets = trimmed_buckets + [trimmed]
		}
	}

	return trimmed_buckets
}

# Check if a value pattern represents all S3 buckets
is_all_s3_pattern = func(value) {
	# Empty string or various ARN patterns that represent all S3 buckets
	return value is "" or
		value is "arn:aws:s3:::*/*" or
		value is "arn:aws:s3:::" or
		value is "arn:aws:s3"
}

# Extract bucket name from ARN pattern
extract_bucket_name_from_arn = func(arn) {
	# ARN format: arn:aws:s3:::bucket-name/* or arn:aws:s3:::bucket-name/prefix/*
	if strings.has_prefix(arn, "arn:aws:s3:::") {
		# Remove the prefix
		remainder = strings.trim_prefix(arn, "arn:aws:s3:::")
		# Split by / to get bucket name
		parts = strings.split(remainder, "/")
		if length(parts) > 0 {
			return parts[0]
		}
	}
	return ""
}

# Check if specific bucket names are covered by the resource values
are_target_buckets_covered = func(resource_values, target_buckets) {
	if length(target_buckets) == 0 {
		# No specific buckets specified, check for all buckets
		return false
	}

	# Track which target buckets are covered
	covered_buckets = {}
	for target_buckets as bucket {
		covered_buckets[bucket] = false
	}

	# Check each resource value
	for resource_values as value {
		# Check if it's an all-buckets pattern
		if is_all_s3_pattern(value) {
			# All buckets covered
			for target_buckets as bucket {
				covered_buckets[bucket] = true
			}
			return true
		}

		# Extract bucket name from ARN
		bucket_name = extract_bucket_name_from_arn(value)
		if bucket_name is not "" {
			# Check if this bucket is in our target list
			for target_buckets as target {
				if bucket_name is target {
					covered_buckets[target] = true
				}
			}
		}
	}

	# Check if all target buckets are covered
	for covered_buckets as bucket, is_covered {
		if not is_covered {
			return false
		}
	}

	return true
}

are_target_buckets_excluded = func(resource_values, target_buckets) {
	if length(resource_values) == 0 or length(target_buckets) == 0 {
		return false
	}

	for resource_values as value {
		if is_all_s3_pattern(value) {
			return true
		}

		bucket_name = extract_bucket_name_from_arn(value)
		if bucket_name is not "" {
			for target_buckets as target {
				if bucket_name is target {
					return true
				}
			}
		}
	}

	return false
}

# Check if advanced event selectors are configured for S3 data events
check_advanced_event_selectors = func(res) {
	advanced_selectors = maps.get(res.values, const.advanced_event_selector, [])
	target_buckets = get_target_bucket_names()

	if length(advanced_selectors) == 0 {
		return false
	}

	# Check each advanced event selector
	for advanced_selectors as selector {
		field_selectors = maps.get(selector, const.field_selector, [])

		has_data_category = false
		has_s3_resource = false
		has_event_name_filter = false
		resource_arn_includes = []
		resource_arn_excludes = []
		has_resource_arn_filter = false

		# Check field selectors for Data category and S3 resource type
		for field_selectors as field_selector {
			field_name = maps.get(field_selector, const.field, "")
			equals_values = maps.get(field_selector, const.equals, [])
			starts_with_values = maps.get(field_selector, const.starts_with, [])
			ends_with_values = maps.get(field_selector, const.ends_with, [])
			not_equals_values = maps.get(field_selector, const.not_equals, [])
			not_starts_with_values = maps.get(field_selector, const.not_starts_with, [])
			not_ends_with_values = maps.get(field_selector, const.not_ends_with, [])

			# Check for eventCategory = Data
			if field_name is "eventCategory" {
				for equals_values as val {
					if val is "Data" {
						has_data_category = true
					}
				}
			}

			# Check for resources.type = AWS::S3::Object
			if field_name is "resources.type" {
				for equals_values as val {
					if val is const.s3_resource_type {
						has_s3_resource = true
					}
				}
			}

			# Check for resources.ARN to get specific bucket inclusions/exclusions
			if field_name is "resources.ARN" {
				has_resource_arn_filter = length(equals_values) > 0 or
					length(starts_with_values) > 0 or
					length(ends_with_values) > 0 or
					length(not_equals_values) > 0 or
					length(not_starts_with_values) > 0 or
					length(not_ends_with_values) > 0

				resource_arn_includes = resource_arn_includes + equals_values + starts_with_values + ends_with_values
				resource_arn_excludes = resource_arn_excludes + not_equals_values + not_starts_with_values + not_ends_with_values
			}

			# Check if eventName filter is present (restricts to specific operations)
			if field_name is "eventName" {
				has_event_name_filter = true
			}
		}

		# Must have data category and S3 resource, but NOT have eventName filter
		if has_data_category and has_s3_resource and not has_event_name_filter {
			# If no specific buckets requested, check for all buckets
			if length(target_buckets) == 0 {
				# Exclusion filters do not represent logging all S3 buckets.
				if length(resource_arn_excludes) > 0 {
					continue
				}

				# No explicit ARN filter means all S3 objects.
				if not has_resource_arn_filter {
					return true
				}

				for resource_arn_includes as arn {
					if is_all_s3_pattern(arn) {
						return true
					}
				}
			} else {
				# Check if specific target buckets are covered
				if are_target_buckets_excluded(resource_arn_excludes, target_buckets) {
					continue
				}

				if not has_resource_arn_filter {
					# Empty means all buckets, so target buckets are covered
					return true
				}

				# Only exclusion filters means all buckets except excluded targets.
				if length(resource_arn_includes) == 0 and length(resource_arn_excludes) > 0 {
					return true
				}

				if are_target_buckets_covered(resource_arn_includes, target_buckets) {
					return true
				}
			}
		}
	}

	return false
}

# Check if legacy event selectors are configured for S3 data events
check_legacy_event_selectors = func(res) {
	event_selectors = maps.get(res.values, const.event_selector, [])
	target_buckets = get_target_bucket_names()

	if length(event_selectors) == 0 {
		return false
	}

	# Check each event selector
	for event_selectors as event_selector {
		# Check read_write_type is "All" (not ReadOnly or WriteOnly)
		read_write_type = maps.get(event_selector, "read_write_type", "All")
		if read_write_type is not "All" {
			continue
		}

		data_resources = maps.get(event_selector, const.data_resource, [])

		# Check each data resource
		for data_resources as data_resource {
			resource_type = maps.get(data_resource, const.type, "")
			resource_values = maps.get(data_resource, const.values, [])

			# Check if this data resource is for S3 objects
			if resource_type is const.s3_resource_type {
				# If no specific buckets requested, check for all buckets
				if length(target_buckets) == 0 {
					# Empty values array implies all resources
					if length(resource_values) == 0 {
						return true
					}

					# Check if any value pattern represents all S3 buckets
					for resource_values as value {
						if is_all_s3_pattern(value) {
							return true
						}
					}
				} else {
					# Check if specific target buckets are covered
					# Empty values array implies all resources
					if length(resource_values) == 0 {
						return true
					}

					# Check if target buckets are covered
					if are_target_buckets_covered(resource_values, target_buckets) {
						return true
					}
				}
			}
		}
	}

	return false
}

# Check if a trail has event selectors configured for all S3 buckets
is_trail_logging_all_s3_data_events = func(res) {
	# Check if logging is enabled
	enable_logging = maps.get(res.values, "enable_logging", true)
	if enable_logging is false {
		return false
	}

	# Check advanced event selectors first (newer format)
	if check_advanced_event_selectors(res) {
		return true
	}

	# Fall back to legacy event selectors
	return check_legacy_event_selectors(res)
}

generate_violation_message = func() {
	target_buckets = get_target_bucket_names()

	if length(target_buckets) == 0 {
		return "At least one AWS CloudTrail trail must be logging Amazon S3 data events for all S3 buckets. Configure event selectors with data resource type 'AWS::S3::Object' and values set to 'arn:aws:s3:::*/*' to capture object-level API operations across all buckets"
	}

	bucket_list = strings.join(target_buckets, ", ")
	return "At least one AWS CloudTrail trail must be logging Amazon S3 data events for the specified S3 buckets: " + bucket_list + ". Configure event selectors with data resource type 'AWS::S3::Object' and appropriate bucket ARNs to capture object-level API operations"
}

# Variables
cloudtrail_resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_cloudtrail).resources

# Check if at least one trail is logging all S3 data events
compliant_trails = filter cloudtrail_resources as _, res {
	is_trail_logging_all_s3_data_events(res) is true
}

# If no compliant trails found, this is a violation
# We create a synthetic violation since this is an account-level requirement
violations = []
if length(compliant_trails) == 0 {
	violations = [{
		"address":        "account-level-requirement",
		"module_address": "",
		"message":        generate_violation_message(),
	}]
}

summary = {
	"policy_name": const.policy_name,
	"violations":  violations,
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
