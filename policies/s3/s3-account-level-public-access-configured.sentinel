# This policy verifies if the attributes of the 'aws_s3_account_public_access_block'
# resource are in accordance to AWS standards for S3 Account-Level Public Access Block Settings.

# Copyright IBM Corp. 2024, 2025
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps
import "strings"

# Parameters
param ignore_public_acls default true
param block_public_policy default true
param block_public_acls default true
param restrict_public_buckets default true

# Constants
const = {
	"policy_name":             "s3-account-level-public-access-configured",
	"resource_type":           "aws_s3_account_public_access_block",
	"ignore_public_acls":      "ignore_public_acls",
	"block_public_policy":     "block_public_policy",
	"block_public_acls":       "block_public_acls",
	"restrict_public_buckets": "restrict_public_buckets",
}

# Functions
generate_violation_message = func(res) {
	violations_list = []
	
	ignore_public_acls_value = maps.get(res.values, const.ignore_public_acls, null)
	if ignore_public_acls_value is not ignore_public_acls {
		violations_list += ["IgnorePublicAcls is " + string(ignore_public_acls_value) + " (expected: " + string(ignore_public_acls) + ")"]
	}
	
	block_public_policy_value = maps.get(res.values, const.block_public_policy, null)
	if block_public_policy_value is not block_public_policy {
		violations_list += ["BlockPublicPolicy is " + string(block_public_policy_value) + " (expected: " + string(block_public_policy) + ")"]
	}
	
	block_public_acls_value = maps.get(res.values, const.block_public_acls, null)
	if block_public_acls_value is not block_public_acls {
		violations_list += ["BlockPublicAcls is " + string(block_public_acls_value) + " (expected: " + string(block_public_acls) + ")"]
	}
	
	restrict_public_buckets_value = maps.get(res.values, const.restrict_public_buckets, null)
	if restrict_public_buckets_value is not restrict_public_buckets {
		violations_list += ["RestrictPublicBuckets is " + string(restrict_public_buckets_value) + " (expected: " + string(restrict_public_buckets) + ")"]
	}
	
	message = "Account-level S3 public access block settings are not compliant. "
	if length(violations_list) > 0 {
		message += "Issues: " + strings.join(violations_list, ", ")
	}
	message += ". All settings (IgnorePublicAcls, BlockPublicPolicy, BlockPublicAcls, RestrictPublicBuckets) must be enabled to prevent unintended public access to S3 buckets and objects. Refer to https://docs.aws.amazon.com/config/latest/developerguide/s3-account-level-public-access-blocks.html for more details."
	
	return message
}

is_compliant = func(res) {
	ignore_public_acls_value = maps.get(res.values, const.ignore_public_acls, null)
	block_public_policy_value = maps.get(res.values, const.block_public_policy, null)
	block_public_acls_value = maps.get(res.values, const.block_public_acls, null)
	restrict_public_buckets_value = maps.get(res.values, const.restrict_public_buckets, null)
	
	return ignore_public_acls_value is ignore_public_acls and
		block_public_policy_value is block_public_policy and
		block_public_acls_value is block_public_acls and
		restrict_public_buckets_value is restrict_public_buckets
}

# Variables
resources = tf.plan(tfplan.planned_values.resources).type(const.resource_type).resources
violations = collection.reject(resources, func(res) {
	return is_compliant(res)
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
