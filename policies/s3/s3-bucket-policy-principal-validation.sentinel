# This policy verifies that AWS S3 buckets have appropriate access restrictions
# by checking bucket policies for restricted access to specific principals, IPs, or VPCs.
# Refer to https://docs.aws.amazon.com/config/latest/developerguide/s3-bucket-policy-grantee-check.html for more details.

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfconfig/v2" as tfconfig
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps
import "strings"
import "types"

# Parameters
# awsPrincipals: Comma-separated list of IAM User ARNs, IAM Role ARNs, and AWS accounts
param awsPrincipals default ""

# servicePrincipals: Comma-separated list of service principals
param servicePrincipals default ""

# federatedUsers: Comma-separated list of identity providers for web identity federation
param federatedUsers default ""

# ipAddresses: Comma-separated list of CIDR formatted IP addresses
param ipAddresses default ""

# vpcIds: Comma-separated list of Amazon VPC IDs
param vpcIds default ""

# Constants
const = {
	"policy_name":            "s3-bucket-policy-principal-validation",
	"resource_s3_bucket":     "aws_s3_bucket",
	"resource_bucket_policy": "aws_s3_bucket_policy",
	"policy_attr":            "policy",
}

# Helper Functions

# Parse CSV string into list, handling spaces and empty values
parse_csv = func(csv_string) {
	if csv_string is "" or csv_string is null {
		return []
	}

	# Split by comma and trim spaces
	items = strings.split(csv_string, ",")
	result = []

	for items as item {
		trimmed = strings.trim_space(item)
		if trimmed is not "" {
			result = result + [trimmed]
		}
	}

	return result
}

# Check if a principal matches any in the allowed list (supports partial matching)
principal_matches_allowed = func(principal, allowed_list) {
	if length(allowed_list) is 0 {
		return true
	}

	for allowed_list as allowed {
		# Exact match
		if principal is allowed {
			return true
		}

		# Partial match for ARN patterns (e.g., arn:aws:iam::123456789012:role/*)
		if strings.has_suffix(allowed, "*") {
			prefix = strings.trim_suffix(allowed, "*")
			if strings.has_prefix(principal, prefix) {
				return true
			}
		}

		# Check if principal contains the allowed pattern
		if principal matches ".*" + allowed + ".*" {
			return true
		}
	}

	return false
}

# Check if an IP address matches any in the allowed list
ip_matches_allowed = func(ip, allowed_list) {
	if length(allowed_list) is 0 {
		return true
	}

	for allowed_list as allowed {
		if ip is allowed or ip matches ".*" + allowed + ".*" {
			return true
		}
	}

	return false
}

# Check if a VPC ID matches any in the allowed list
vpc_matches_allowed = func(vpc, allowed_list) {
	if length(allowed_list) is 0 {
		return true
	}

	for allowed_list as allowed {
		if vpc is allowed or vpc matches ".*" + allowed + ".*" {
			return true
		}
	}

	return false
}

# Extract and validate principals from policy statement
validate_aws_principals = func(policy_str, allowed_aws_principals) {
	# If no allowed list, any specific principal is OK (not wildcard)
	if length(allowed_aws_principals) is 0 {
		# Just check it's not wildcard
		if policy_str matches ".*\"Principal\"\\s*:\\s*\"\\*\".*" {
			return false
		}
		if policy_str matches ".*\"AWS\"\\s*:\\s*\"\\*\".*" {
			return false
		}
		# Any specific principal is acceptable
		return true
	}

	# Extract AWS principals and validate against allowed list
	# Look for patterns like: "AWS": "arn:aws:iam::123456789012:..."
	# or "AWS": ["arn:...", "arn:..."]

	# Check for wildcard - not allowed when we have restrictions
	if policy_str matches ".*\"AWS\"\\s*:\\s*\"\\*\".*" {
		return false
	}

	# Extract account IDs from ARNs in the policy
	# Pattern: arn:aws:iam::ACCOUNT_ID:
	if policy_str matches ".*arn:aws:iam::[0-9]{12}:.*" {
		# Check if any of the allowed principals match
		for allowed_aws_principals as allowed {
			if policy_str matches ".*" + allowed + ".*" {
				return true
			}
		}
		# Found ARN but doesn't match allowed list
		return false
	}

	# No AWS principals found in this statement
	return true
}

# Validate service principals
validate_service_principals = func(policy_str, allowed_service_principals) {
	# Check if policy has service principals
	if not (policy_str matches ".*\"Service\".*") {
		return true
	}

	# If no allowed list, any service principal is OK
	if length(allowed_service_principals) is 0 {
		return true
	}

	# Check if service principal matches allowed list
	for allowed_service_principals as allowed {
		if policy_str matches ".*" + allowed + ".*" {
			return true
		}
	}

	# Service principal found but not in allowed list
	return false
}

# Validate federated users
validate_federated_users = func(policy_str, allowed_federated_users) {
	# Check if policy has federated principals
	if not (policy_str matches ".*\"Federated\".*") {
		return true
	}

	# If no allowed list, any federated user is OK
	if length(allowed_federated_users) is 0 {
		return true
	}

	# Check if federated user matches allowed list
	for allowed_federated_users as allowed {
		if policy_str matches ".*" + allowed + ".*" {
			return true
		}
	}

	# Federated user found but not in allowed list
	return false
}

# Validate IP addresses in conditions
validate_ip_addresses = func(policy_str, allowed_ips) {
	# Check if policy has IP conditions
	has_ip_condition = policy_str matches ".*aws:SourceIp.*" or policy_str matches ".*IpAddress.*"

	if not has_ip_condition {
		# No IP condition - OK if no IP restrictions required
		return length(allowed_ips) is 0
	}

	# If no allowed list, any IP restriction is OK
	if length(allowed_ips) is 0 {
		return true
	}

	# Check if IP matches allowed list
	for allowed_ips as allowed {
		if policy_str matches ".*" + allowed + ".*" {
			return true
		}
	}

	# IP condition found but not in allowed list
	return false
}

# Validate VPC IDs in conditions
validate_vpc_ids = func(policy_str, allowed_vpcs) {
	# Check if policy has VPC conditions
	has_vpc_condition = policy_str matches ".*aws:SourceVpc.*" or policy_str matches ".*aws:SourceVpce.*"

	if not has_vpc_condition {
		# No VPC condition - OK if no VPC restrictions required
		return length(allowed_vpcs) is 0
	}

	# If no allowed list, any VPC restriction is OK
	if length(allowed_vpcs) is 0 {
		return true
	}

	# Check if VPC matches allowed list
	for allowed_vpcs as allowed {
		if policy_str matches ".*" + allowed + ".*" {
			return true
		}
	}

	# VPC condition found but not in allowed list
	return false
}

# Main validation function - validates a single statement
validate_statement = func(policy_str, aws_principals_list, service_principals_list, federated_users_list, ip_list, vpc_list) {
	# Deny statements are always acceptable (they restrict access)
	if policy_str matches ".*\"Effect\"\\s*:\\s*\"Deny\".*" {
		return true
	}

	# For Allow statements, validate all principal types and conditions
	if policy_str matches ".*\"Effect\"\\s*:\\s*\"Allow\".*" {
		# Check for unrestricted wildcard principal
		if policy_str matches ".*\"Principal\"\\s*:\\s*\"\\*\".*" {
			# Wildcard principal must have conditions that restrict access
			if not (policy_str matches ".*\"Condition\".*") {
				# Wildcard without conditions is a violation
				return false
			}

			# Wildcard with conditions - validate the conditions
			# Must match at least one of the allowed restrictions
			has_valid_restriction = false

			# Check IP restrictions
			if length(ip_list) > 0 {
				if validate_ip_addresses(policy_str, ip_list) {
					has_valid_restriction = true
				}
			}

			# Check VPC restrictions
			if length(vpc_list) > 0 {
				if validate_vpc_ids(policy_str, vpc_list) {
					has_valid_restriction = true
				}
			}

			# Check principal account restrictions in conditions
			if length(aws_principals_list) > 0 {
				if policy_str matches ".*aws:PrincipalAccount.*" {
					if validate_aws_principals(policy_str, aws_principals_list) {
						has_valid_restriction = true
					}
				}
				if policy_str matches ".*aws:PrincipalOrgID.*" {
					has_valid_restriction = true
				}
			}

			# If we have parameter restrictions but no valid restriction found
			if length(aws_principals_list) > 0 or length(ip_list) > 0 or length(vpc_list) > 0 {
				return has_valid_restriction
			}

			# No parameter restrictions - any condition is acceptable
			return true
		}

		# Not a wildcard principal - validate specific principals
		valid = true

		# Validate AWS principals
		if not validate_aws_principals(policy_str, aws_principals_list) {
			valid = false
		}

		# Validate service principals
		if not validate_service_principals(policy_str, service_principals_list) {
			valid = false
		}

		# Validate federated users
		if not validate_federated_users(policy_str, federated_users_list) {
			valid = false
		}

		# Validate IP conditions if present
		if policy_str matches ".*aws:SourceIp.*" or policy_str matches ".*IpAddress.*" {
			if not validate_ip_addresses(policy_str, ip_list) {
				valid = false
			}
		}

		# Validate VPC conditions if present
		if policy_str matches ".*aws:SourceVpc.*" or policy_str matches ".*aws:SourceVpce.*" {
			if not validate_vpc_ids(policy_str, vpc_list) {
				valid = false
			}
		}

		return valid
	}

	# No Effect specified - treat as invalid
	return false
}

# Validate entire policy (may contain multiple statements)
validate_policy = func(policy_str, aws_principals_list, service_principals_list, federated_users_list, ip_list, vpc_list) {
	# Empty policy is compliant
	if policy_str is "" or policy_str is null {
		return true
	}

	# Check if policy has Statement array
	if policy_str matches ".*\"Statement\".*" {
		# Policy has statements - need to validate each one
		# Since we can't parse JSON properly in Sentinel, we'll do a simplified check
		# Look for multiple statement blocks

		# For now, validate the entire policy as one unit
		# In a real implementation, you'd parse JSON and validate each statement
		return validate_statement(policy_str, aws_principals_list, service_principals_list, federated_users_list, ip_list, vpc_list)
	}

	# No statements found - invalid policy
	return false
}

# has_bucket_reference_in_config checks if bucket policy properly references the bucket in config
has_bucket_reference_in_config = func(policy_address, bucket_config_resources) {
	# Check if bucket attribute has references
	bucket_config = maps.get(policy_address.config, "bucket", {})
	references = maps.get(bucket_config, "references", [])
	if length(references) > 0 {
		for references as _, ref {
			# Check if reference points to an aws_s3_bucket resource
			if strings.has_prefix(ref, "aws_s3_bucket.") {
				# Verify the bucket resource exists
				bucket_name = strings.split(ref, ".")[1]
				for bucket_config_resources as _, bucket_res {
					if bucket_res.name is bucket_name {
						return true
					}
				}
			}
		}
	}
	# If no references found, it might be using a constant value (bucket name string)
	# which is also valid
	constant_value = maps.get(bucket_config, "constant_value", "")
	if constant_value is not "" {
		return true
	}
	return false
}

generate_violation_message = func(violation) {
	return "S3 bucket policy '" + violation.address + "' does not have sufficient access restrictions. Bucket policies must restrict access by AWS principals, federated users, service principals, IP addresses, or VPCs that you provide. Each statement in the bucket policy is evaluated against this rule"
}

# Parse CSV parameters
aws_principals_list = parse_csv(awsPrincipals)
service_principals_list = parse_csv(servicePrincipals)
federated_users_list = parse_csv(federatedUsers)
ip_list = parse_csv(ipAddresses)
vpc_list = parse_csv(vpcIds)

# Variables
bucket_config_resources = tf.config(tfconfig.resources).type(const.resource_s3_bucket).resources
policy_config_resources = tf.config(tfconfig.resources).type(const.resource_bucket_policy).resources

# If no bucket policies exist, the rule is COMPLIANT (per AWS Config rule spec)
# Only check policies that exist
violations = collection.reject(policy_config_resources, func(policy) {
	# Verify the policy properly references the bucket in config
	if not has_bucket_reference_in_config(policy, bucket_config_resources) {
		return false
	}

	policy_config = maps.get(policy.config, const.policy_attr, {})
	policy_content = maps.get(policy_config, "constant_value", "")
	if policy_content is "" {
		# No policy content - compliant
		return true
	}
	return validate_policy(policy_content, aws_principals_list, service_principals_list, federated_users_list, ip_list, vpc_list)
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
