# This policy requires that AWS S3 buckets have default encryption enabled
# or have a bucket policy that explicitly denies put-object requests without server side encryption

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps
import "strings"
import "json"

# Constants
const = {
	"policy_name":                                                 "s3-bucket-server-side-encryption-enabled",
	"resource_aws_s3_bucket":                                      "aws_s3_bucket",
	"resource_aws_s3_bucket_policy":                               "aws_s3_bucket_policy",
	"resource_aws_s3_bucket_server_side_encryption_configuration": "aws_s3_bucket_server_side_encryption_configuration",
}

# Functions
# Check if bucket has server_encryption_configuration block defined
has_bucket_encryption = func(bucket_res) {
	server_side_encryption_configuration = maps.get(bucket_res.values, "server_side_encryption_configuration", [])
	if length(server_side_encryption_configuration) > 0 {
		return true
	}
	return false
}

# Check if there's a separate aws_s3_bucket_server_side_encryption_configuration resource for this bucket
has_separate_encryption_resource = func(bucket_address, encryption_resources) {
	for encryption_resources as _, enc_res {
		bucket_ref = maps.get(enc_res.values, "bucket", "")
		if strings.has_suffix(bucket_ref, bucket_address) or bucket_ref is bucket_address {
			return true
		}
	}
	return false
}

# Check if a policy statement properly denies unencrypted uploads
is_valid_deny_statement = func(statement) {
	# Must have Deny effect
	effect = maps.get(statement, "Effect", "")
	if effect is not "Deny" {
		return false
	}

	# Must have s3:PutObject action
	actions_raw = maps.get(statement, "Action", "")
	has_putobject = false

	# Check if it's a direct match (string case)
	if actions_raw is "s3:PutObject" or actions_raw is "s3:*" {
		has_putobject = true
	}

	# Also check if it's in a list
	if actions_raw contains "s3:PutObject" or actions_raw contains "s3:*" {
		has_putobject = true
	}

	if not has_putobject {
		return false
	}

	# Must have a condition that checks for encryption
	condition = maps.get(statement, "Condition", {})
	if condition is {} {
		return false
	}

	# Check for valid encryption-denying conditions
	# StringNotEquals or Null are valid for denying unencrypted uploads
	# StringEquals would require encryption to match a specific value, not deny unencrypted
	has_valid_condition = false

	# Check for StringNotEquals with s3:x-amz-server-side-encryption
	string_not_equals = maps.get(condition, "StringNotEquals", {})
	if string_not_equals is not {} {
		if "s3:x-amz-server-side-encryption" in keys(string_not_equals) {
			has_valid_condition = true
		}
	}

	# Check for Null condition with s3:x-amz-server-side-encryption
	null_condition = maps.get(condition, "Null", {})
	if null_condition is not {} {
		if "s3:x-amz-server-side-encryption" in keys(null_condition) {
			encryption_value = maps.get(null_condition, "s3:x-amz-server-side-encryption", "")
			# Null: {"s3:x-amz-server-side-encryption": "true"} denies when header is missing
			if encryption_value is "true" or encryption_value is true {
				has_valid_condition = true
			}
		}
	}

	return has_valid_condition
}

# Check if bucket policy denies unencrypted put-object requests
has_deny_unencrypted_policy = func(bucket_address, bucket_name, policy_resources) {
	for policy_resources as _, policy_res {
		bucket_ref = maps.get(policy_res.values, "bucket", "")
		policy_json_str = maps.get(policy_res.values, "policy", "")

		# Check if policy is for this bucket
		# Match by address, bucket name, or if bucket_ref contains the address
		bucket_matches = strings.has_suffix(bucket_ref, bucket_address) or bucket_ref is bucket_address or bucket_ref is bucket_name or strings.has_suffix(bucket_address, bucket_ref)

		if bucket_matches and policy_json_str is not "" {
			# Parse the JSON policy
			policy_doc = json.unmarshal(policy_json_str)

			# Get statements from policy
			statements_raw = maps.get(policy_doc, "Statement", [])
			# Handle both single statement and list of statements
			statements = []
			if length(statements_raw) else 0 is 0 {
				# It's likely a map (single statement), wrap it
				statements = [statements_raw]
			} else {
				statements = statements_raw
			}

			# Check if any statement properly denies unencrypted uploads
			for statements as _, statement {
				if is_valid_deny_statement(statement) {
					return true
				}
			}
		}
	}
	return false
}

# Check if bucket is compliant
is_bucket_compliant = func(bucket_res, policy_resources, encryption_resources) {
	# Check if bucket has encryption in the bucket resource itself
	if has_bucket_encryption(bucket_res) {
		return true
	}

	# Check if there's a separate encryption configuration resource
	if has_separate_encryption_resource(bucket_res.address, encryption_resources) {
		return true
	}

	# Get bucket name from values
	bucket_name = maps.get(bucket_res.values, "bucket", "")

	# Check if bucket policy denies unencrypted uploads
	if has_deny_unencrypted_policy(bucket_res.address, bucket_name, policy_resources) {
		return true
	}

	return false
}

generate_violation_message = func(violation) {
	return "S3 bucket '" + violation.address + "' must have default encryption enabled or a bucket policy that explicitly denies put-object requests without server side encryption. Refer to https://docs.aws.amazon.com/config/latest/developerguide/s3-bucket-server-side-encryption-enabled.html for more details."
}

# Variables
bucket_resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_s3_bucket).resources
policy_resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_s3_bucket_policy).resources
encryption_resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_s3_bucket_server_side_encryption_configuration).resources

violations = collection.reject(bucket_resources, func(res) {
	return is_bucket_compliant(res, policy_resources, encryption_resources)
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
