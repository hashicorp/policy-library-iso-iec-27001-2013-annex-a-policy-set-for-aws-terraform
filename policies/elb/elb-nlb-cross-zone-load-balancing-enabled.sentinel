# This policy verifies that cross-zone load balancing is enabled on Network Load Balancers (NLBs).

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps

# Constants
const = {
	"policy_name":                      "elb-nlb-cross-zone-load-balancing-enabled",
	"resource_aws_lb":                  "aws_lb",
	"load_balancer_type":               "load_balancer_type",
	"enable_cross_zone_load_balancing": "enable_cross_zone_load_balancing",
	"network_load_balancer_type":       "network",
}

# Functions
generate_violation_message = func(violation) {
	cross_zone_value = maps.get(violation.values, const.enable_cross_zone_load_balancing, null)

	if cross_zone_value is null {
		return "Network Load Balancer '" + violation.address + "' does not have 'enable_cross_zone_load_balancing' attribute set. Cross-zone load balancing must be enabled for Network Load Balancers. Refer to https://docs.aws.amazon.com/config/latest/developerguide/nlb-cross-zone-load-balancing-enabled.html for more details."
	}

	return "Network Load Balancer '" + violation.address + "' has 'enable_cross_zone_load_balancing' set to " + string(cross_zone_value) + ". Cross-zone load balancing must be enabled for Network Load Balancers. Refer to https://docs.aws.amazon.com/config/latest/developerguide/nlb-cross-zone-load-balancing-enabled.html for more details."
}

is_network_load_balancer = func(res) {
	lb_type = maps.get(res.values, const.load_balancer_type, "application")
	return lb_type is const.network_load_balancer_type
}

is_cross_zone_enabled = func(res) {
	# For NLBs, enable_cross_zone_load_balancing must be explicitly set to true
	enable_attr = maps.get(res.values, const.enable_cross_zone_load_balancing, false)
	return enable_attr is true
}

# Variables
# Get all aws_lb resources (aws_lb is the correct resource for ELBv2 including NLBs)
aws_lb_resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_lb).resources

# Filter only Network Load Balancers
nlb_resources = filter aws_lb_resources as _, res {
	is_network_load_balancer(res)
}

# Check for violations
violations = collection.reject(nlb_resources, func(res) {
	return is_cross_zone_enabled(res)
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
