# This policy verifies that cross-zone load balancing is enabled on Network Load Balancers (NLBs).

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps

# Constants
const = {
	"policy_name":                         "elb-nlb-cross-zone-load-balancing-enabled",
	"resource_aws_lb":                     "aws_lb",
	"resource_aws_alb":                    "aws_alb",
	"load_balancer_type":                  "load_balancer_type",
	"enable_cross_zone_load_balancing":    "enable_cross_zone_load_balancing",
	"cross_zone_load_balancing_enabled":   "cross_zone_load_balancing_enabled",
	"network_load_balancer_type":          "network",
}

# Functions
generate_violation_message = func(violation) {
	# Check both possible attribute names
	cross_zone_value_enable = maps.get(violation.values, const.enable_cross_zone_load_balancing, null)
	cross_zone_value_enabled = maps.get(violation.values, const.cross_zone_load_balancing_enabled, null)
	
	if cross_zone_value_enable is null and cross_zone_value_enabled is null {
		return "Network Load Balancer '" + violation.address + "' does not have cross-zone load balancing attribute set. Cross-zone load balancing must be enabled for Network Load Balancers. Refer to https://docs.aws.amazon.com/config/latest/developerguide/nlb-cross-zone-load-balancing-enabled.html for more details."
	}
	
	cross_zone_value = cross_zone_value_enable
	attr_name = "enable_cross_zone_load_balancing"
	if cross_zone_value is null {
		cross_zone_value = cross_zone_value_enabled
		attr_name = "cross_zone_load_balancing_enabled"
	}
	
	return "Network Load Balancer '" + violation.address + "' has '" + attr_name + "' set to " + string(cross_zone_value) + ". Cross-zone load balancing must be enabled for Network Load Balancers. Refer to https://docs.aws.amazon.com/config/latest/developerguide/nlb-cross-zone-load-balancing-enabled.html for more details."
}

is_network_load_balancer = func(res) {
	lb_type = maps.get(res.values, const.load_balancer_type, "application")
	return lb_type is const.network_load_balancer_type
}

is_cross_zone_enabled = func(res) {
	# Check both possible attribute names
	enable_attr = maps.get(res.values, const.enable_cross_zone_load_balancing, null)
	enabled_attr = maps.get(res.values, const.cross_zone_load_balancing_enabled, null)
	
	# Return true if either attribute is explicitly set to true
	return (enable_attr is true) or (enabled_attr is true)
}

# Variables
aws_lb_resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_lb).resources
aws_alb_resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_alb).resources

# Filter only Network Load Balancers from aws_lb resources
nlb_resources_from_lb = filter aws_lb_resources as _, res {
	is_network_load_balancer(res)
}

# Filter only Network Load Balancers from aws_alb resources
nlb_resources_from_alb = filter aws_alb_resources as _, res {
	is_network_load_balancer(res)
}

# Combine both resource types
all_nlb_resources = {}
for nlb_resources_from_lb as addr, res {
	all_nlb_resources[addr] = res
}
for nlb_resources_from_alb as addr, res {
	all_nlb_resources[addr] = res
}

# Check for violations
violations = collection.reject(all_nlb_resources, func(res) {
	return is_cross_zone_enabled(res)
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
