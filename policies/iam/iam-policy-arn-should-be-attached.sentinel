
# This policy ensures that IAM policies are actually in use by being attached to
# IAM users, groups (with users), or roles (with trusted entities).

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps
import "strings"
import "json"

# Constants
const = {
	"policy_name":                    "iam-policy-in-use",
	"resource_aws_iam_policy":        "aws_iam_policy",
	"resource_aws_iam_user_policy_attachment": "aws_iam_user_policy_attachment",
	"resource_aws_iam_group_policy_attachment": "aws_iam_group_policy_attachment",
	"resource_aws_iam_role_policy_attachment": "aws_iam_role_policy_attachment",
	"resource_aws_iam_policy_attachment": "aws_iam_policy_attachment",
	"resource_aws_iam_group_membership": "aws_iam_group_membership",
	"resource_aws_iam_role":          "aws_iam_role",
}

# Functions
get_policy_arn = func(res) {
	# Handle both direct ARN and self-reference
	if maps.has(res.values, "arn") and res.values.arn is not null {
		return res.values.arn
	}
	# Return address as fallback for matching references
	return res.address
}

is_policy_attached_to_user = func(policy_identifier, user_attachments) {
	for user_attachments as _, attachment {
		policy_arn = maps.get(attachment.values, "policy_arn", "")
		if policy_arn is policy_identifier or policy_arn contains policy_identifier {
			return true
		}
	}
	return false
}

is_policy_attached_to_group = func(policy_identifier, group_attachments, group_memberships) {
	# Find groups with this policy attached and check if they have members
	for group_attachments as _, attachment {
		policy_arn = maps.get(attachment.values, "policy_arn", "")
		if policy_arn is policy_identifier or policy_arn contains policy_identifier {
			group_name = maps.get(attachment.values, "group", "")
			# Check if this group has any members
			for group_memberships as _, membership {
				membership_group = maps.get(membership.values, "group", "")
				users = maps.get(membership.values, "users", [])
				if membership_group is group_name and length(users) > 0 {
					return true
				}
			}
		}
	}
	
	return false
}

has_trusted_entities = func(assume_role_policy_json) {
	# Parse the assume role policy JSON and check if it has any statements
	if assume_role_policy_json is "" or assume_role_policy_json is null {
		return false
	}
	
	# Try to parse the JSON
	policy = json.unmarshal(assume_role_policy_json)
	
	# Check if Statement exists and has at least one entry
	if maps.has(policy, "Statement") {
		statements = policy.Statement
		if statements is not null and length(statements) > 0 {
			return true
		}
	}
	
	return false
}

is_policy_attached_to_role = func(policy_identifier, role_attachments, roles) {
	# Find roles with this policy attached and check if they have trusted entities
	for role_attachments as _, attachment {
		policy_arn = maps.get(attachment.values, "policy_arn", "")
		if policy_arn is policy_identifier or policy_arn contains policy_identifier {
			role_name = maps.get(attachment.values, "role", "")
			# Check if this role exists and has an assume role policy with trusted entities
			for roles as _, r {
				r_name = maps.get(r.values, "name", "")
				assume_role_policy = maps.get(r.values, "assume_role_policy", "")
				if r_name is role_name and has_trusted_entities(assume_role_policy) {
					return true
				}
			}
		}
	}
	
	return false
}

is_policy_attached_via_generic = func(policy_identifier, generic_attachments) {
	# Check aws_iam_policy_attachment which can attach to users, groups, or roles
	for generic_attachments as _, attachment {
		policy_arn = maps.get(attachment.values, "policy_arn", "")
		users = maps.get(attachment.values, "users", [])
		groups = maps.get(attachment.values, "groups", [])
		roles = maps.get(attachment.values, "roles", [])
		
		if (policy_arn is policy_identifier or policy_arn contains policy_identifier) and
			(length(users) > 0 or length(groups) > 0 or length(roles) > 0) {
			return true
		}
	}
	return false
}

is_policy_in_use = func(policy, user_attachments, group_attachments, role_attachments, generic_attachments, group_memberships, roles) {
	policy_identifier = get_policy_arn(policy)
	
	# Check if policy is attached to any users
	if is_policy_attached_to_user(policy_identifier, user_attachments) {
		return true
	}
	
	# Check if policy is attached to groups with members
	if is_policy_attached_to_group(policy_identifier, group_attachments, group_memberships) {
		return true
	}
	
	# Check if policy is attached to roles with trusted entities
	if is_policy_attached_to_role(policy_identifier, role_attachments, roles) {
		return true
	}
	
	# Check generic policy attachments
	if is_policy_attached_via_generic(policy_identifier, generic_attachments) {
		return true
	}
	
	return false
}

generate_violation_message = func(violation) {
	return "IAM policy '" + violation.address + "' is not attached to any IAM user, group with users, or role with trusted entities. Policies should be in use to comply with AWS Audit Manager requirements. Refer to https://docs.aws.amazon.com/audit-manager/latest/userguide/control-data-sources.html for more details."
}

# Variables
policies = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_iam_policy).resources
user_attachments = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_iam_user_policy_attachment).resources
group_attachments = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_iam_group_policy_attachment).resources
role_attachments = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_iam_role_policy_attachment).resources
generic_attachments = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_iam_policy_attachment).resources
group_memberships = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_iam_group_membership).resources
roles = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_iam_role).resources

violations = collection.reject(policies, func(policy) {
	return is_policy_in_use(policy, user_attachments, group_attachments, role_attachments, generic_attachments, group_memberships, roles)
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
