# This policy ensures that IAM policies are actually in use by being attached to
# IAM users, groups (with users), or roles (with trusted entities).

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfconfig/v2" as tfconfig
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps
import "strings"
import "json"

# Parameters
param policyARN default ""
param policyUsageType default "ANY"

# Constants
const = {
	"policy_name":                              "iam-policy-arn-should-be-attached",
	"resource_aws_iam_policy":                  "aws_iam_policy",
	"resource_aws_iam_user":                    "aws_iam_user",
	"resource_aws_iam_group":                   "aws_iam_group",
	"resource_aws_iam_user_policy_attachment":  "aws_iam_user_policy_attachment",
	"resource_aws_iam_group_policy_attachment": "aws_iam_group_policy_attachment",
	"resource_aws_iam_role_policy_attachment":  "aws_iam_role_policy_attachment",
	"resource_aws_iam_role":                    "aws_iam_role",
	"resource_aws_iam_group_membership":        "aws_iam_group_membership",
}

# Functions
get_policy_arn = func(res) {
	# For tfconfig, we use the resource address as the identifier
	# since ARN values are not available in config
	return res.address
}

# Helper function to check if a policy_arn reference matches a policy identifier
matches_policy = func(policy_arn, policy_identifier) {
	# Direct match
	if policy_arn is policy_identifier {
		return true
	}

	# Check if policy_arn contains the policy identifier (for Terraform references)
	# This handles cases like "${aws_iam_policy.my_policy.arn}" matching "aws_iam_policy.my_policy"
	if policy_arn contains policy_identifier {
		return true
	}

	# Extract resource address from policy_identifier if it's a full address
	# e.g., "aws_iam_policy.my_policy" -> "my_policy"
	if strings.has_prefix(policy_identifier, "aws_iam_policy.") {
		resource_name = strings.trim_prefix(policy_identifier, "aws_iam_policy.")
		# Check if policy_arn references this resource name
		if policy_arn contains resource_name {
			return true
		}
	}

	return false
}

is_policy_attached_to_user = func(policy_identifier, user_attachments, users) {
	for user_attachments as _, attachment {
		# Get policy_arn from config - it can be a constant or reference
		policy_arn_config = maps.get(attachment.config, "policy_arn", {})

		# Check for constant value
		if maps.has(policy_arn_config, "constant_value") {
			policy_arn = policy_arn_config.constant_value
			if matches_policy(policy_arn, policy_identifier) {
				# Verify the user exists
				user_config = maps.get(attachment.config, "user", {})
				if maps.has(user_config, "references") {
					return true
				} else if maps.has(user_config, "constant_value") {
					user_name = user_config.constant_value
					for users as _, u {
						u_name_config = maps.get(u.config, "name", {})
						if maps.has(u_name_config, "constant_value") and u_name_config.constant_value is user_name {
							return true
						}
					}
				}
			}
		}

		# Check for references to the policy
		if maps.has(policy_arn_config, "references") {
			for policy_arn_config.references as _, ref {
				if matches_policy(ref, policy_identifier) {
					# Verify the user exists
					user_config = maps.get(attachment.config, "user", {})
					if maps.has(user_config, "references") or maps.has(user_config, "constant_value") {
						return true
					}
				}
			}
		}
	}
	return false
}

is_policy_attached_to_group = func(policy_identifier, group_attachments, group_memberships, groups) {
	# Find groups with this policy attached and check if they have members
	for group_attachments as _, attachment {
		# Get policy_arn from config
		policy_arn_config = maps.get(attachment.config, "policy_arn", {})
		policy_matches = false

		# Check for constant value
		if maps.has(policy_arn_config, "constant_value") {
			policy_arn = policy_arn_config.constant_value
			if matches_policy(policy_arn, policy_identifier) {
				policy_matches = true
			}
		}

		# Check for references to the policy
		if maps.has(policy_arn_config, "references") {
			for policy_arn_config.references as _, ref {
				if matches_policy(ref, policy_identifier) {
					policy_matches = true
				}
			}
		}

		if policy_matches {
			# Get group name from config
			group_config = maps.get(attachment.config, "group", {})
			group_name = ""

			if maps.has(group_config, "constant_value") {
				group_name = group_config.constant_value
			} else if maps.has(group_config, "references") {
				# Extract group name from reference
				for group_config.references as _, ref {
					if strings.has_prefix(ref, "aws_iam_group.") {
						# Verify the group exists
						for groups as _, g {
							if g.address is ref or strings.has_suffix(ref, g.address) {
								group_name_config = maps.get(g.config, "name", {})
								if maps.has(group_name_config, "constant_value") {
									group_name = group_name_config.constant_value
								}
							}
						}
					}
				}
			}

			# Check if this group has any members
			if group_name is not "" {
				for group_memberships as _, membership {
					membership_group_config = maps.get(membership.config, "group", {})
					membership_group = ""

					if maps.has(membership_group_config, "constant_value") {
						membership_group = membership_group_config.constant_value
					} else if maps.has(membership_group_config, "references") {
						# Extract group name from reference
						for membership_group_config.references as _, ref {
							if strings.has_prefix(ref, "aws_iam_group.") {
								# Find the group and get its name
								for groups as _, g {
									if g.address is ref or strings.has_suffix(ref, g.address) {
										g_name_config = maps.get(g.config, "name", {})
										if maps.has(g_name_config, "constant_value") {
											membership_group = g_name_config.constant_value
										}
									}
								}
							}
						}
					}

					users_config = maps.get(membership.config, "users", {})
					users = []
					if maps.has(users_config, "constant_value") {
						users = users_config.constant_value
					}

					if membership_group is group_name and length(users) > 0 {
						return true
					}
				}
			}
		}
	}

	return false
}

has_trusted_entities = func(assume_role_policy_json) {
	# Parse the assume role policy JSON and check if it has any statements
	# Returns false if JSON is empty, null, or malformed
	if assume_role_policy_json is "" or assume_role_policy_json is null {
		return false
	}

	# Parse the JSON
	policy = json.unmarshal(assume_role_policy_json)

	# Check if Statement exists and has at least one entry
	# This also handles the case where json.unmarshal returns undefined or invalid data
	if policy is not null and maps.has(policy, "Statement") {
		statements = policy.Statement
		if statements is not null and length(statements) > 0 {
			return true
		}
	}

	return false
}

is_policy_attached_to_role = func(policy_identifier, role_attachments, roles) {
	# Find roles with this policy attached and check if they have trusted entities
	for role_attachments as _, attachment {
		# Get policy_arn from config
		policy_arn_config = maps.get(attachment.config, "policy_arn", {})
		policy_matches = false

		# Check for constant value
		if maps.has(policy_arn_config, "constant_value") {
			policy_arn = policy_arn_config.constant_value
			if matches_policy(policy_arn, policy_identifier) {
				policy_matches = true
			}
		}

		# Check for references to the policy
		if maps.has(policy_arn_config, "references") {
			for policy_arn_config.references as _, ref {
				if matches_policy(ref, policy_identifier) {
					policy_matches = true
				}
			}
		}

		if policy_matches {
			# Get role name from config
			role_config = maps.get(attachment.config, "role", {})
			role_name = ""

			if maps.has(role_config, "constant_value") {
				role_name = role_config.constant_value
			} else if maps.has(role_config, "references") {
				# Extract role name from reference
				for role_config.references as _, ref {
					if strings.has_prefix(ref, "aws_iam_role.") {
						# Verify the role exists
						for roles as _, r {
							if r.address is ref or strings.has_suffix(ref, r.address) {
								role_name_config = maps.get(r.config, "name", {})
								if maps.has(role_name_config, "constant_value") {
									role_name = role_name_config.constant_value
								}
							}
						}
					}
				}
			}

			# Check if this role exists and has an assume role policy with trusted entities
			if role_name is not "" {
				for roles as _, r {
					r_name_config = maps.get(r.config, "name", {})
					r_name = ""
					if maps.has(r_name_config, "constant_value") {
						r_name = r_name_config.constant_value
					}

					assume_role_policy_config = maps.get(r.config, "assume_role_policy", {})
					assume_role_policy = ""
					if maps.has(assume_role_policy_config, "constant_value") {
						assume_role_policy = assume_role_policy_config.constant_value
					}

					if r_name is role_name and has_trusted_entities(assume_role_policy) {
						return true
					}
				}
			}
		}
	}

	return false
}

is_policy_in_use = func(policy, user_attachments, group_attachments, role_attachments, group_memberships, roles, users, groups, usage_type) {
	policy_identifier = get_policy_arn(policy)

	# Check based on policyUsageType parameter
	if usage_type is "IAM_USER" or usage_type is "ANY" {
		# Check if policy is attached to any users
		if is_policy_attached_to_user(policy_identifier, user_attachments, users) {
			return true
		}
	}

	if usage_type is "IAM_GROUP" or usage_type is "ANY" {
		# Check if policy is attached to groups with members
		if is_policy_attached_to_group(policy_identifier, group_attachments, group_memberships, groups) {
			return true
		}
	}

	if usage_type is "IAM_ROLE" or usage_type is "ANY" {
		# Check if policy is attached to roles with trusted entities
		if is_policy_attached_to_role(policy_identifier, role_attachments, roles) {
			return true
		}
	}

	return false
}

# Helper function to check if a policy matches the policyARN parameter
matches_policy_arn_param = func(policy, policy_arn_param) {
	# If no policyARN parameter is specified, match all policies
	if policy_arn_param is "" or policy_arn_param is null {
		return true
	}

	policy_identifier = get_policy_arn(policy)

	# Direct match
	if policy_identifier is policy_arn_param {
		return true
	}

	# Check if the policy ARN contains the parameter (for partial matches)
	if policy_identifier contains policy_arn_param {
		return true
	}

	# Check if parameter contains the policy identifier (for reference matches)
	if policy_arn_param contains policy_identifier {
		return true
	}

	return false
}

generate_violation_message = func(violation) {
	return "IAM policy '" + violation.address + "' is not attached to any IAM user, group with users, or role with trusted entities. Policies should be in use to comply with AWS Audit Manager requirements. Refer to https://docs.aws.amazon.com/config/latest/developerguide/iam-policy-in-use.html for more details."
}

# Variables
all_policies = tf.config(tfconfig.resources).type(const.resource_aws_iam_policy).resources
user_attachments = tf.config(tfconfig.resources).type(const.resource_aws_iam_user_policy_attachment).resources
group_attachments = tf.config(tfconfig.resources).type(const.resource_aws_iam_group_policy_attachment).resources
role_attachments = tf.config(tfconfig.resources).type(const.resource_aws_iam_role_policy_attachment).resources
group_memberships = tf.config(tfconfig.resources).type(const.resource_aws_iam_group_membership).resources
roles = tf.config(tfconfig.resources).type(const.resource_aws_iam_role).resources
users = tf.config(tfconfig.resources).type(const.resource_aws_iam_user).resources
groups = tf.config(tfconfig.resources).type(const.resource_aws_iam_group).resources

# Filter policies based on policyARN parameter
policies = collection.filter(all_policies, func(policy) {
	return matches_policy_arn_param(policy, policyARN)
})

# Validate policyUsageType parameter
valid_usage_types = ["IAM_USER", "IAM_GROUP", "IAM_ROLE", "ANY"]
usage_type = policyUsageType
if not (usage_type in valid_usage_types) {
	print("Warning: Invalid policyUsageType '", usage_type, "'. Using default 'ANY'. Valid values are: IAM_USER, IAM_GROUP, IAM_ROLE, ANY")
	usage_type = "ANY"
}

violations = collection.reject(policies, func(policy) {
	return is_policy_in_use(policy, user_attachments, group_attachments, role_attachments, group_memberships, roles, users, groups, usage_type)
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
