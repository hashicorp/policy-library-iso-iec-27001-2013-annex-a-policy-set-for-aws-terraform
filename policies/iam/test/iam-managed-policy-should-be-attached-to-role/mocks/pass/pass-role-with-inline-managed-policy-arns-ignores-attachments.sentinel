# This mock demonstrates a scenario where a role has managed_policy_arns defined
# AND there are aws_iam_role_policy_attachment resources for the same role.
# The policy should prioritize managed_policy_arns and ignore the attachments
# to avoid conflicts per Terraform documentation.

planned_values = {
	"outputs": {},
	"resources": {
		"aws_iam_role.example": {
			"address":        "aws_iam_role.example",
			"depends_on":     [],
			"deposed_key":    "",
			"index":          null,
			"mode":           "managed",
			"module_address": "",
			"name":           "example",
			"provider_name":  "registry.terraform.io/hashicorp/aws",
			"tainted":        false,
			"type":           "aws_iam_role",
			"values": {
				"name":               "example-role",
				"assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"ec2.amazonaws.com\"},\"Action\":\"sts:AssumeRole\"}]}",
				"managed_policy_arns": [
					"arn:aws:iam::aws:policy/ReadOnlyAccess",
					"arn:aws:iam::aws:policy/SecurityAudit",
				],
			},
		},
		"aws_iam_role_policy_attachment.example": {
			"address":        "aws_iam_role_policy_attachment.example",
			"depends_on":     [],
			"deposed_key":    "",
			"index":          null,
			"mode":           "managed",
			"module_address": "",
			"name":           "example",
			"provider_name":  "registry.terraform.io/hashicorp/aws",
			"tainted":        false,
			"type":           "aws_iam_role_policy_attachment",
			"values": {
				"role":       "example-role",
				"policy_arn": "arn:aws:iam::aws:policy/ViewOnlyAccess",
			},
		},
	},
}
