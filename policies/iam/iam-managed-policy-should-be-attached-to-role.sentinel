# This policy verifies that all managed policies specified in the parameter list
# are attached to AWS IAM roles.

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps
import "strings"

# Parameters
# managedPolicyArns is a comma-separated list of managed policy ARNs that must be attached to IAM roles
param managedPolicyArns default ""

# Constants
const = {
	"policy_name":                             "iam-managed-policy-should-be-attached-to-role",
	"resource_aws_iam_role_policy_attachment": "aws_iam_role_policy_attachment",
	"resource_aws_iam_role":                   "aws_iam_role",
}

# Parse the CSV parameter into a list and trim whitespace
parse_managed_policy_arns = func(csv_string) {
	if length(csv_string) is 0 {
		return []
	}

	policy_list = strings.split(csv_string, ",")
	trimmed_list = []

	for policy_list as policy {
		trimmed_list = trimmed_list + [strings.trim_space(policy)]
	}

	return trimmed_list
}

trimmed_required_policies = parse_managed_policy_arns(managedPolicyArns)

# Functions
# Get all policy attachments grouped by role
# Only uses aws_iam_role_policy_attachment resources to avoid conflicts with
# the managed_policy_arns attribute on aws_iam_role resources
get_policy_attachments_by_role = func() {
	role_policies = {}

	# Get all aws_iam_role_policy_attachment resources
	attachments = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_iam_role_policy_attachment).resources

	for attachments as _, attachment {
		role_name = maps.get(attachment.values, "role", "")
		policy_arn = maps.get(attachment.values, "policy_arn", "")

		if role_name is not "" and policy_arn is not "" {
			if role_name not in keys(role_policies) {
				role_policies[role_name] = []
			}
			role_policies[role_name] = role_policies[role_name] + [policy_arn]
		}
	}

	return role_policies
}

# Check if a role has all required managed policies attached
has_all_required_policies = func(role_name, attached_policies) {
	for trimmed_required_policies as required_policy {
		policy_found = false
		for attached_policies as attached_policy {
			if attached_policy is required_policy {
				policy_found = true
			}
		}
		if policy_found is false {
			return false
		}
	}
	return true
}

# Generate violation message
generate_violation_message = func(role_name, attached_policies) {
	missing_policies = []
	for trimmed_required_policies as required_policy {
		policy_found = false
		for attached_policies as attached_policy {
			if attached_policy is required_policy {
				policy_found = true
			}
		}
		if policy_found is false {
			missing_policies = missing_policies + [required_policy]
		}
	}

	return "IAM role '" + role_name + "' is missing required managed policies: " + strings.join(missing_policies, ", ") + ". All required managed policies must be attached to IAM roles. Refer to https://docs.aws.amazon.com/config/latest/developerguide/iam-role-managed-policy-check.html for more details."
}

# Variables
roles = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_iam_role).resources
role_policy_map = get_policy_attachments_by_role()

# Use collection.reject to identify violations
violations = collection.reject(roles, func(res) {
	if length(trimmed_required_policies) is 0 {
		return true
	}
	role_name = maps.get(res.values, "name", "")
	attached_policies = maps.get(role_policy_map, role_name, [])
	return has_all_required_policies(role_name, attached_policies)
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(maps.get(v.values, "name", ""), maps.get(role_policy_map, maps.get(v.values, "name", ""), [])),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
