# This policy checks that specified IAM policy ARNs are not attached to IAM users, groups, or roles.
# The rule is NON_COMPLIANT if a blacklisted policy ARN is attached to any IAM resource.

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection/maps" as maps
import "strings"

# Params
# blacklisted_policy_arns is a list of IAM policy ARNs that should not be attached to any IAM resource
param blacklisted_policy_arns default []

# Constants
const = {
	"policy_name":                              "iam-policy-no-blacklisted-arn-allowed",
	"resource_aws_iam_user_policy_attachment":  "aws_iam_user_policy_attachment",
	"resource_aws_iam_group_policy_attachment": "aws_iam_group_policy_attachment",
	"resource_aws_iam_role_policy_attachment":  "aws_iam_role_policy_attachment",
	"resource_aws_iam_policy_attachment":       "aws_iam_policy_attachment",
	"policy_arn":                               "policy_arn",
}

# Functions
is_blacklisted_policy = func(policy_arn) {
	for blacklisted_policy_arns as blacklisted_arn {
		if policy_arn is blacklisted_arn {
			return true
		}
	}
	return false
}

generate_violation_message = func(policy_arn, resource_type) {
	return "Blacklisted IAM policy ARN '" + policy_arn + "' is attached to " + resource_type + ". This violates the IAM policy blacklist check. Refer to https://docs.aws.amazon.com/config/latest/developerguide/iam-policy-blacklisted-check.html for more details."
}

# Variables
user_policy_attachments = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_iam_user_policy_attachment).resources
group_policy_attachments = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_iam_group_policy_attachment).resources
role_policy_attachments = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_iam_role_policy_attachment).resources
policy_attachments = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_iam_policy_attachment).resources

user_violations = filter user_policy_attachments as _, res {
	is_blacklisted_policy(maps.get(res.values, const.policy_arn, "")) is true
}

group_violations = filter group_policy_attachments as _, res {
	is_blacklisted_policy(maps.get(res.values, const.policy_arn, "")) is true
}

role_violations = filter role_policy_attachments as _, res {
	is_blacklisted_policy(maps.get(res.values, const.policy_arn, "")) is true
}

policy_violations = filter policy_attachments as _, res {
	is_blacklisted_policy(maps.get(res.values, const.policy_arn, "")) is true
}

all_violations = []
for user_violations as _, v {
	policy_arn = maps.get(v.values, const.policy_arn, "unknown")
	all_violations += [{
		"address":        v.address,
		"module_address": v.module_address,
		"message":        generate_violation_message(policy_arn, "IAM user"),
	}]
}

for group_violations as _, v {
	policy_arn = maps.get(v.values, const.policy_arn, "unknown")
	all_violations += [{
		"address":        v.address,
		"module_address": v.module_address,
		"message":        generate_violation_message(policy_arn, "IAM group"),
	}]
}

for role_violations as _, v {
	policy_arn = maps.get(v.values, const.policy_arn, "unknown")
	all_violations += [{
		"address":        v.address,
		"module_address": v.module_address,
		"message":        generate_violation_message(policy_arn, "IAM role"),
	}]
}

for policy_violations as _, v {
	policy_arn = maps.get(v.values, const.policy_arn, "unknown")
	all_violations += [{
		"address":        v.address,
		"module_address": v.module_address,
		"message":        generate_violation_message(policy_arn, "IAM entities"),
	}]
}

summary = {
	"policy_name": const.policy_name,
	"violations":  all_violations,
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	all_violations is empty
}
