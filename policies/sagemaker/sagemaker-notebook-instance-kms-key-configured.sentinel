# This policy requires that AWS SageMaker notebook instances have AWS KMS key configured for encryption.
# It checks that the `kms_key_id` attribute is defined and not empty for `aws_sagemaker_notebook_instance` resources.

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps

# Constants
const = {
	"policy_name":   "sagemaker-notebook-instance-kms-key-configured",
	"resource_type": "aws_sagemaker_notebook_instance",
	"kms_key_id":    "kms_key_id",
}

# Functions
generate_violation_message = func(violation) {
	kms_key_id = maps.get(violation.values, const.kms_key_id, null)
	if kms_key_id is null or kms_key_id is "" {
		return "SageMaker notebook instance must have 'kms_key_id' attribute configured for encryption. Refer to https://docs.aws.amazon.com/config/latest/developerguide/sagemaker-notebook-instance-kms-key-configured.html for more details."
	}
	return "SageMaker notebook instance has invalid 'kms_key_id' configuration. The KMS key must be properly specified for encryption. Refer to https://docs.aws.amazon.com/config/latest/developerguide/sagemaker-notebook-instance-kms-key-configured.html for more details."
}

is_kms_configured = func(res) {
	kms_key_id = maps.get(res.values, const.kms_key_id, null)
	if kms_key_id is null {
		return false
	}
	if kms_key_id is "" {
		return false
	}
	return true
}

# Variables
resources = tf.plan(tfplan.planned_values.resources).type(const.resource_type).resources
violations = collection.reject(resources, func(res) {
	return is_kms_configured(res)
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
