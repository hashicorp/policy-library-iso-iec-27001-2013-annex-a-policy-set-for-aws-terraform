# This policy requires that AWS SageMaker endpoint configurations have KMS key configured for encryption.

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps
import "strings"

# Parameters
param kmsKeyArns default ""

# Constants
const = {
	"policy_name":   "sagemaker-endpoint-configuration-kms-key-configured",
	"resource_type": "aws_sagemaker_endpoint_configuration",
	"kms_key_id":    "kms_key_id",
}

# Functions
generate_violation_message = func(violation, allowed_arns) {
	kms_key_id = maps.get(violation.values, const.kms_key_id, null)
	if kms_key_id is null {
		return "SageMaker endpoint configuration '" + violation.address + "' must have KMS key configured for encryption. The 'kms_key_id' attribute must be set. Refer to https://docs.aws.amazon.com/config/latest/developerguide/sagemaker-endpoint-configuration-kms-key-configured.html for more details."
	}
	if kms_key_id is "" {
		return "SageMaker endpoint configuration '" + violation.address + "' must have a valid KMS key configured for encryption. The 'kms_key_id' attribute cannot be empty. Refer to https://docs.aws.amazon.com/config/latest/developerguide/sagemaker-endpoint-configuration-kms-key-configured.html for more details."
	}
	if length(allowed_arns) > 0 {
		return "SageMaker endpoint configuration '" + violation.address + "' has KMS key '" + kms_key_id + "' which is not in the allowed list: [" + strings.join(allowed_arns, ", ") + "]. Refer to https://docs.aws.amazon.com/config/latest/developerguide/sagemaker-endpoint-configuration-kms-key-configured.html for more details."
	}
	return "SageMaker endpoint configuration '" + violation.address + "' must have a valid KMS key configured for encryption. The 'kms_key_id' attribute cannot be empty. Refer to https://docs.aws.amazon.com/config/latest/developerguide/sagemaker-endpoint-configuration-kms-key-configured.html for more details."
}

is_kms_key_configured = func(res, allowed_arns) {
	kms_key_id = maps.get(res.values, const.kms_key_id, null)

	# Check if KMS key is configured
	if kms_key_id is null {
		return false
	}
	if kms_key_id is "" {
		return false
	}

	# If no allowed ARNs specified, any valid KMS key is acceptable
	if length(allowed_arns) == 0 {
		return true
	}

	# Check if the configured KMS key is in the allowed list
	for allowed_arns as arn {
		if kms_key_id == arn {
			return true
		}
	}

	return false
}

# Parse allowed KMS key ARNs from parameter
parse_allowed_arns = func(arns_param) {
	if arns_param is "" {
		return []
	}
	# Split by comma and trim whitespace
	arns = strings.split(arns_param, ",")
	trimmed_arns = {}
	for arns as arn {
		trimmed = strings.trim_space(arn)
		if trimmed != "" {
			trimmed_arns[trimmed] = true
		}
	}
	return keys(trimmed_arns)
}

# Variables
allowed_kms_arns = parse_allowed_arns(kmsKeyArns)
resources = tf.plan(tfplan.planned_values.resources).type(const.resource_type).resources

violations = collection.reject(resources, func(res) {
	return is_kms_key_configured(res, allowed_kms_arns)
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v, allowed_kms_arns),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
