resources = {
	"aws_redshift_cluster.example": {
		"address":             "aws_redshift_cluster.example",
		"mode":                "managed",
		"type":                "aws_redshift_cluster",
		"name":                "example",
		"provider_config_key": "aws",
		"expressions": {
			"cluster_identifier": {
				"constant_value": "example-cluster",
			},
			"encrypted": {
				"constant_value": true,
			},
			"node_type": {
				"constant_value": "dc1.large",
			},
		},
		"schema_version": 0,
	},
}
