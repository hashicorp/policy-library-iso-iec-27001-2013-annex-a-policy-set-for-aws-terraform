resources = {
	"aws_redshift_cluster.example": {
		"address":             "aws_redshift_cluster.example",
		"mode":                "managed",
		"type":                "aws_redshift_cluster",
		"name":                "example",
		"provider_config_key": "aws",
		"expressions": {
			"cluster_identifier": {
				"constant_value": "my-redshift-cluster",
			},
			"node_type": {
				"constant_value": "dc2.large",
			},
			"master_username": {
				"constant_value": "admin",
			},
			"master_password": {
				"constant_value": "Password123!",
			},
		},
		"schema_version": 0,
	},
	"aws_redshift_logging.example": {
		"address":             "aws_redshift_logging.example",
		"mode":                "managed",
		"type":                "aws_redshift_logging",
		"name":                "example",
		"provider_config_key": "aws",
		"expressions": {
			"cluster_identifier": {
				"references": [
					"aws_redshift_cluster.example.id",
					"aws_redshift_cluster.example",
				],
			},
			"bucket_name": {
				"constant_value": "my-audit-logs-bucket",
			},
			"log_destination_type": {
				"constant_value": "s3",
			},
			"s3_key_prefix": {
				"constant_value": "redshift-logs/",
			},
		},
		"schema_version": 0,
	},
}
