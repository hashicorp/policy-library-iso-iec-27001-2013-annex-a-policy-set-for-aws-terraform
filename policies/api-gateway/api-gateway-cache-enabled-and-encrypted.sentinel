# This policy verifies that all methods in Amazon API Gateway stages have cache enabled and encrypted.
# It checks both aws_api_gateway_stage and aws_api_gateway_method_settings resources.

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps

# Constants
const = {
	"policy_name":                              "api-gateway-cache-enabled-and-encrypted",
	"message":                                  "API Gateway stages must have cache enabled and encrypted. Refer to https://docs.aws.amazon.com/config/latest/developerguide/api-gw-cache-enabled-and-encrypted.html for more details.",
	"resource_aws_api_gateway_stage":           "aws_api_gateway_stage",
	"resource_aws_api_gateway_method_settings": "aws_api_gateway_method_settings",
	"cache_cluster_enabled":                    "cache_cluster_enabled",
	"cache_data_encrypted":                     "cache_data_encrypted",
	"caching_enabled":                          "caching_enabled",
	"rest_api_id":                              "rest_api_id",
	"settings":                                 "settings",
	"stage_name":                               "stage_name",
}

# Functions
get_matching_method_settings = func(stage, method_settings_resources) {
	stage_rest_api_id = maps.get(stage.values, const.rest_api_id, "")
	stage_name = maps.get(stage.values, const.stage_name, "")

	return filter method_settings_resources as _, res {
		maps.get(res.values, const.rest_api_id, "") is stage_rest_api_id and
			maps.get(res.values, const.stage_name, "") is stage_name
	}
}

generate_stage_violation_message = func(violation, method_settings_resources) {
	cache_enabled = maps.get(violation.values, const.cache_cluster_enabled, false)
	matching_method_settings = get_matching_method_settings(violation, method_settings_resources)

	if not cache_enabled {
		return "API Gateway stage must have cache cluster enabled. Attribute 'cache_cluster_enabled' must be set to true. Refer to https://docs.aws.amazon.com/config/latest/developerguide/api-gw-cache-enabled-and-encrypted.html for more details."
	}
	if length(matching_method_settings) is 0 {
		return "API Gateway stage must have associated aws_api_gateway_method_settings with caching enabled and cache encrypted. Refer to https://docs.aws.amazon.com/config/latest/developerguide/api-gw-cache-enabled-and-encrypted.html for more details."
	}
	return "API Gateway stage must have cache cluster enabled and all associated method settings must enable caching and cache encryption. Refer to https://docs.aws.amazon.com/config/latest/developerguide/api-gw-cache-enabled-and-encrypted.html for more details."
}

generate_method_settings_violation_message = func(violation) {
	settings = maps.get(violation.values, const.settings, [])

	if length(settings) == 0 {
		return "API Gateway method settings must have caching enabled and cache encrypted. Settings block is missing or empty. Refer to https://docs.aws.amazon.com/config/latest/developerguide/api-gw-cache-enabled-and-encrypted.html for more details."
	}

	return "API Gateway method settings must have caching enabled and cache encrypted in the settings block. Refer to https://docs.aws.amazon.com/config/latest/developerguide/api-gw-cache-enabled-and-encrypted.html for more details."
}

is_method_settings_compliant = func(res) {
	settings = maps.get(res.values, const.settings, [])

	if length(settings) == 0 {
		return false
	}

	return collection.find(settings, func(setting) {
		caching_enabled = maps.get(setting, const.caching_enabled, false)
		cache_encrypted = maps.get(setting, const.cache_data_encrypted, false)

		return caching_enabled is not true or cache_encrypted is not true
	}) is not defined
}

is_stage_compliant = func(res, method_settings_resources) {
	cache_enabled = maps.get(res.values, const.cache_cluster_enabled, false)

	# Check stage-level cache settings
	if cache_enabled is not true {
		return false
	}

	matching_method_settings = get_matching_method_settings(res, method_settings_resources)

	# Terraform manages stage cache encryption through aws_api_gateway_method_settings
	if length(matching_method_settings) is 0 {
		return false
	}

	return collection.find(matching_method_settings, func(method_settings) {
		return not is_method_settings_compliant(method_settings)
	}) is not defined
}

# Variables
stage_resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_api_gateway_stage).resources
method_settings_resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_api_gateway_method_settings).resources

stage_violations = collection.reject(stage_resources, func(res) {
	return is_stage_compliant(res, method_settings_resources)
})

method_settings_violations = collection.reject(method_settings_resources, func(res) {
	return is_method_settings_compliant(res)
})

# Combine violations for reporting
all_violations = []
for stage_violations as _, v {
	all_violations += [{
		"address":        v.address,
		"module_address": v.module_address,
		"message":        generate_stage_violation_message(v, method_settings_resources),
	}]
}

for method_settings_violations as _, v {
	all_violations += [{
		"address":        v.address,
		"module_address": v.module_address,
		"message":        generate_method_settings_violation_message(v),
	}]
}

summary = {
	"policy_name": const.policy_name,
	"violations":  all_violations,
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	length(stage_violations) + length(method_settings_violations) is 0
}
