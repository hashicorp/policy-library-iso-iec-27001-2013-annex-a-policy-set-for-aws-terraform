# This policy verifies that AWS Aurora DB instances are protected by a backup plan.
# The rule is NON_COMPLIANT if the Aurora DB instance is not covered by a backup plan.
# Note: This rule only applies to Amazon Aurora DB instances. DB clusters are not supported.

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps
import "strings"

# Constants
const = {
	"policy_name":                   "rds-aurora-in-backup-plan",
	"resource_aws_db_instance":      "aws_db_instance",
	"resource_aws_backup_selection": "aws_backup_selection",
	"message":                       "Aurora DB instance is not covered by a backup plan. Refer to https://docs.aws.amazon.com/config/latest/developerguide/rds-in-backup-plan.html for more details.",
	"aurora_engines": [
		"aurora",
		"aurora-mysql",
		"aurora-postgresql",
	],
}

# Functions
# Check if engine is Aurora
is_aurora_engine = func(engine) {
	for const.aurora_engines as _, aurora_engine {
		if strings.has_prefix(engine, aurora_engine) {
			return true
		}
	}
	return false
}

# Get all Aurora RDS DB instance ARNs from planned resources
get_aurora_instance_arns = func() {
	rds_resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_db_instance).resources
	arns = {}

	for rds_resources as address, res {
		# Only process Aurora instances
		engine = maps.get(res.values, "engine", "")
		if not is_aurora_engine(engine) {
			continue
		}

		# Construct ARN pattern for RDS instance
		# RDS ARNs follow pattern: arn:aws:rds:region:account-id:db:db-instance-name
		instance_id = maps.get(res.values, "identifier", "")
		if instance_id is not "" {
			arns[address] = instance_id
		}
	}

	return arns
}

# Get all backup selections with their resources and tags
get_backup_selections = func() {
	backup_selections = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_backup_selection).resources
	selections = []

	for backup_selections as _, sel {
		selection = {
			"resources":      maps.get(sel.values, "resources", []),
			"selection_tags": maps.get(sel.values, "selection_tag", []),
		}
		# Append to list using array concatenation
		selections = selections + [selection]
	}

	return selections
}

# Check if RDS instance tags match selection tags
check_tag_match = func(rds_tags, selection_tags) {
	# If no selection tags, return false (not protected by tags)
	if length(selection_tags) == 0 {
		return false
	}

	# Check if all selection tags match (AND logic)
	for selection_tags as _, tag_condition {
		tag_type = maps.get(tag_condition, "type", "")
		tag_key = maps.get(tag_condition, "key", "")
		tag_value = maps.get(tag_condition, "value", "")

		# Get the RDS instance tag value
		rds_tag_value = maps.get(rds_tags, tag_key, "")

		# Check based on type
		if tag_type == "STRINGEQUALS" {
			if rds_tag_value != tag_value {
				return false
			}
		}
	}

	return true
}

# Check if RDS instance is protected by backup plan
is_rds_protected = func(rds_resource, backup_selections) {
	rds_identifier = maps.get(rds_resource.values, "identifier", "")
	rds_arn = maps.get(rds_resource.values, "arn", "")
	rds_tags = maps.get(rds_resource.values, "tags", {})

	# Check each backup selection
	for backup_selections as _, selection {
		# Check resource-based protection
		resources_list = selection.resources
		for resources_list as _, protected_arn {
			# Check for exact ARN match
			if protected_arn == rds_arn {
				return true
			}

			# Check if identifier is in the ARN (for partial ARN matches)
			if strings.has_suffix(protected_arn, ":db:" + rds_identifier) {
				return true
			}

			# Check for wildcard patterns like arn:aws:rds:*:*:db:*
			if strings.has_suffix(protected_arn, ":db:*") {
				# Extract the prefix before :db:*
				arn_prefix = strings.trim_suffix(protected_arn, ":db:*")
				# Check if RDS ARN starts with this prefix
				if strings.has_prefix(rds_arn, arn_prefix) {
					return true
				}
			}
		}

		# Check tag-based protection
		selection_tags = selection.selection_tags
		if check_tag_match(rds_tags, selection_tags) {
			return true
		}
	}

	return false
}

generate_violation_message = func(rds_address, engine) {
	return "Aurora DB instance '" + rds_address + "' (engine: " + engine + ") is not covered by an AWS Backup plan. Ensure the instance is included in a backup selection resource. Refer to https://docs.aws.amazon.com/config/latest/developerguide/rds-in-backup-plan.html for more details."
}

# Variables
all_rds_resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_db_instance).resources
backup_selections = get_backup_selections()

# Filter for Aurora instances only
aurora_resources = collection.filter(all_rds_resources, func(res) {
	engine = maps.get(res.values, "engine", "")
	return is_aurora_engine(engine)
})

violations = collection.reject(aurora_resources, func(res) {
	return is_rds_protected(res, backup_selections)
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v.address, maps.get(v.values, "engine", "")),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
