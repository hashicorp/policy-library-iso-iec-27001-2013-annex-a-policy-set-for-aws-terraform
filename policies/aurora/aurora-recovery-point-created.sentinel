# This policy ensures that a recovery point was created for Amazon Aurora DB clusters
# within the specified time period to enable backup and disaster recovery capabilities.

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps
import "strings"

# Params
# max_days_since_backup refers to the maximum number of days allowed since the last backup
param max_days_since_backup default 1

# Constants
const = {
	"policy_name":              "aurora-recovery-point-created",
	"message":                  "Aurora DB cluster must have automated backups configured to ensure recovery points are created. Refer to https://docs.aws.amazon.com/config/latest/developerguide/aurora-last-backup-recovery-point-created.html for more details.",
	"resource_aws_rds_cluster": "aws_rds_cluster",
	"backup_retention_period":  "backup_retention_period",
	"engine":                   "engine",
}

# Functions
is_aurora_cluster = func(res) {
	engine = maps.get(res.values, const.engine, "")
	return strings.has_prefix(engine, "aurora")
}

has_backup_enabled = func(res) {
	backup_retention = maps.get(res.values, const.backup_retention_period, 0)
	return backup_retention > max_days_since_backup
}

generate_violation_message = func(violation) {
	backup_retention = maps.get(violation.values, const.backup_retention_period, 0)

	if backup_retention is 0 {
		return "Aurora DB cluster '" + violation.address + "' does not have automated backups enabled. The 'backup_retention_period' must be at least " + string(max_days_since_backup) + " day(s) to ensure recovery points are created. Refer to https://docs.aws.amazon.com/config/latest/developerguide/aurora-last-backup-recovery-point-created.html for more details."
	}

	return "Aurora DB cluster '" + violation.address + "' must have automated backups configured with a backup_retention_period of at least " + string(max_days_since_backup) + " day(s) to ensure recent recovery points are available. Current backup_retention_period: " + string(backup_retention) + ". Refer to https://docs.aws.amazon.com/config/latest/developerguide/aurora-last-backup-recovery-point-created.html for more details."
}

# Variables
rds_clusters = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_rds_cluster).resources

aurora_clusters = filter rds_clusters as _, res {
	is_aurora_cluster(res)
}

violations = collection.reject(aurora_clusters, func(res) {
	return has_backup_enabled(res)
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
