# This policy checks if AWS Backup vaults have resource-based policies that prevent manual deletion of recovery points.
# The rule is NON_COMPLIANT if the Backup Vault does not have resource-based policies or has policies without
# a suitable 'Deny' statement with backup:DeleteRecoveryPoint, backup:UpdateRecoveryPointLifecycle,
# and backup:PutBackupVaultAccessPolicy permissions.

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfconfig/v2" as tfconfig
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps
import "strings"
import "json"
import "types"

# Params
# principalArnList (Optional)
# Type: CSV
# Comma-separated list of AWS Identity and Access Management (IAM) Amazon Resource Names (ARNs) for the rule to NOT check.
param principalArnList default ""

# Constants
const = {
	"policy_name":                  "backup-recovery-point-manual-deletion-disabled",
	"constant_value":               "constant_value",
	"references":                   "references",
	"resource_backup_vault":        "aws_backup_vault",
	"resource_backup_vault_policy": "aws_backup_vault_policy",
	"required_actions": [
		"backup:DeleteRecoveryPoint",
		"backup:UpdateRecoveryPointLifecycle",
		"backup:PutBackupVaultAccessPolicy",
	],
	"message": "Backup vault must have a resource-based policy with Deny statements for backup:DeleteRecoveryPoint, " +
		"backup:UpdateRecoveryPointLifecycle, and backup:PutBackupVaultAccessPolicy to prevent manual deletion of recovery points. " +
		"Refer to https://docs.aws.amazon.com/config/latest/developerguide/backup-recovery-point-manual-deletion-disabled.html for more details.",
}

# Functions
get_config_attribute = func(res, attr) {
	return maps.get(res, "config." + attr, {})
}

get_constant_value = func(attr, fallback) {
	return maps.get(attr, const.constant_value, fallback)
}

# Parse comma-separated list of principal ARNs
get_excluded_principals = func() {
	if principalArnList is "" {
		return []
	}

	# Split by comma and trim whitespace
	principals = strings.split(principalArnList, ",")
	trimmed_principals = []
	for principals as principal {
		trimmed = strings.trim_space(principal)
		if trimmed is not "" {
			trimmed_principals = trimmed_principals + [trimmed]
		}
	}

	return trimmed_principals
}

# Check if a principal ARN is in the exclusion list
is_principal_excluded = func(principal_arn) {
	excluded_principals = get_excluded_principals()

	for excluded_principals as excluded {
		if principal_arn is excluded {
			return true
		}
	}

	return false
}

get_statement_principals = func(statement) {
	principal_raw = maps.get(statement, "Principal", "")
	if principal_raw is "" {
		return []
	}

	# Principal can be a string like "*". That is not an excludable ARN.
	if types.type_of(principal_raw) is "string" {
		return []
	}

	aws_principal = maps.get(principal_raw, "AWS", "")
	if aws_principal is "" {
		return []
	}

	# Handle a single ARN string.
	if types.type_of(aws_principal) is "string" {
		return [aws_principal]
	}

	# Otherwise assume it is already a list.
	return aws_principal
}

get_statement_actions = func(statement) {
	actions_raw = maps.get(statement, "Action", [])

	# Handle a single action string.
	if types.type_of(actions_raw) is "string" {
		return [actions_raw]
	}

	return actions_raw
}

# Check if a policy document contains required Deny statements
# Also checks if the principal is excluded from the rule
has_required_deny_statements = func(policy_json) {
	# Parse the policy JSON
	policy_doc = json.unmarshal(policy_json)

	# Get statements
	statements = maps.get(policy_doc, "Statement", [])

	# Look for Deny statements with all required actions
	for statements as statement {
		effect = maps.get(statement, "Effect", "")
		if effect is not "Deny" {
			continue
		}

		# Check if the principal in this statement is excluded
		statement_principals = get_statement_principals(statement)
		if length(statement_principals) > 0 {
			excluded_principals = filter statement_principals as principal_arn {
				is_principal_excluded(principal_arn)
			}

			# If all explicit principals in this statement are excluded, skip the statement.
			if length(excluded_principals) is length(statement_principals) {
				continue
			}
		}

		# Get actions from the statement
		actions = get_statement_actions(statement)

		# Check if all required actions are present
		has_delete = false
		has_update = false
		has_put = false

		for actions as action {
			action_lower = strings.to_lower(action)
			if strings.has_suffix(action_lower, "deleterecoverypoint") or action_lower is "backup:deleterecoverypoint" {
				has_delete = true
			}
			if strings.has_suffix(action_lower, "updaterecoverypointlifecycle") or action_lower is "backup:updaterecoverypointlifecycle" {
				has_update = true
			}
			if strings.has_suffix(action_lower, "putbackupvaultaccesspolicy") or action_lower is "backup:putbackupvaultaccesspolicy" {
				has_put = true
			}
		}

		# If all three actions are found in this Deny statement, policy is compliant
		if has_delete and has_update and has_put {
			return true
		}
	}

	return false
}

# Check if backup vault has compliant policy
policy_matches_vault = func(policy, vault) {
	policy_vault_name = maps.get(policy, "config.backup_vault_name.constant_value", "")
	vault_name = maps.get(vault, "config.name.constant_value", "")

	if policy_vault_name is not "" and policy_vault_name is vault_name {
		return true
	}

	policy_references = maps.get(policy, "config.backup_vault_name.references", [])
	return vault.address in policy_references or
		(vault.address + ".name") in policy_references or
		vault.name in policy_references
}

vault_has_compliant_policy = func(vault, vault_policies) {
	# Find policy for this vault
	for vault_policies as _, policy {
		if policy_matches_vault(policy, vault) {
			# Found policy for this vault, check if it has required Deny statements
			policy_json = maps.get(policy, "config.policy.constant_value", "")
			if policy_json is "" {
				return false
			}
			return has_required_deny_statements(policy_json)
		}
	}

	# No policy found for this vault
	return false
}

# Variables
planned_resources = tf.plan(tfplan.planned_values.resources)
config_resources = tf.config(tfconfig.resources)
backup_vaults = config_resources.type(const.resource_backup_vault).resources
vault_policies = config_resources.type(const.resource_backup_vault_policy).resources

violations = collection.reject(backup_vaults, func(vault) {
	return vault_has_compliant_policy(vault, vault_policies)
})

generate_violation_message = func(vault) {
	vault_name = maps.get(vault, "config.name.constant_value", "")
	return "Backup vault '" + vault.address + "' (name: " + vault_name + ") does not have a compliant resource-based policy. " +
		"Backup vault must have a resource-based policy with Deny statements for backup:DeleteRecoveryPoint, " +
		"backup:UpdateRecoveryPointLifecycle, and backup:PutBackupVaultAccessPolicy to prevent manual deletion of recovery points. " +
		"Refer to https://docs.aws.amazon.com/config/latest/developerguide/backup-recovery-point-manual-deletion-disabled.html for more details."
}

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
