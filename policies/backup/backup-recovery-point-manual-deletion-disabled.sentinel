# This policy checks if AWS Backup vaults have resource-based policies that prevent manual deletion of recovery points.
# The rule is NON_COMPLIANT if the Backup Vault does not have resource-based policies or has policies without
# a suitable 'Deny' statement with backup:DeleteRecoveryPoint, backup:UpdateRecoveryPointLifecycle,
# and backup:PutBackupVaultAccessPolicy permissions.

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps
import "strings"
import "json"

# Constants
const = {
	"policy_name":                  "backup-recovery-point-manual-deletion-disabled",
	"resource_backup_vault":        "aws_backup_vault",
	"resource_backup_vault_policy": "aws_backup_vault_policy",
	"required_actions": [
		"backup:DeleteRecoveryPoint",
		"backup:UpdateRecoveryPointLifecycle",
		"backup:PutBackupVaultAccessPolicy",
	],
	"message": "Backup vault must have a resource-based policy with Deny statements for backup:DeleteRecoveryPoint, " +
		"backup:UpdateRecoveryPointLifecycle, and backup:PutBackupVaultAccessPolicy to prevent manual deletion of recovery points. " +
		"Refer to https://docs.aws.amazon.com/config/latest/developerguide/backup-recovery-point-manual-deletion-disabled.html for more details.",
}

# Functions
# Check if a policy document contains required Deny statements
has_required_deny_statements = func(policy_json) {
	# Parse the policy JSON
	policy_doc = json.unmarshal(policy_json)

	# Get statements
	statements = maps.get(policy_doc, "Statement", [])

	# Look for Deny statements with all required actions
	for statements as statement {
		effect = maps.get(statement, "Effect", "")
		if effect is not "Deny" {
			continue
		}

		# Get actions from the statement
		actions_raw = maps.get(statement, "Action", [])

		# Convert single action to list if needed
		# Check if it's a list by trying to iterate
		actions = []
		if length(actions_raw) else 0 is 0 {
			# It's a string, convert to list
			actions = [actions_raw]
		} else {
			actions = actions_raw
		}

		# Check if all required actions are present
		has_delete = false
		has_update = false
		has_put = false

		for actions as action {
			action_lower = strings.to_lower(action)
			if strings.has_suffix(action_lower, "deleterecoverypoint") or action_lower is "backup:deleterecoverypoint" {
				has_delete = true
			}
			if strings.has_suffix(action_lower, "updaterecoverypointlifecycle") or action_lower is "backup:updaterecoverypointlifecycle" {
				has_update = true
			}
			if strings.has_suffix(action_lower, "putbackupvaultaccesspolicy") or action_lower is "backup:putbackupvaultaccesspolicy" {
				has_put = true
			}
		}

		# If all three actions are found in this Deny statement, policy is compliant
		if has_delete and has_update and has_put {
			return true
		}
	}

	return false
}

# Check if backup vault has compliant policy
vault_has_compliant_policy = func(vault_name, vault_policies) {
	# Find policy for this vault
	for vault_policies as _, policy {
		policy_vault_name = maps.get(policy.values, "backup_vault_name", "")
		if policy_vault_name is vault_name {
			# Found policy for this vault, check if it has required Deny statements
			policy_json = maps.get(policy.values, "policy", "")
			if policy_json is "" {
				return false
			}
			return has_required_deny_statements(policy_json)
		}
	}

	# No policy found for this vault
	return false
}

# Variables
backup_vaults = tf.plan(tfplan.planned_values.resources).type(const.resource_backup_vault).resources
vault_policies = tf.plan(tfplan.planned_values.resources).type(const.resource_backup_vault_policy).resources

violations = collection.reject(backup_vaults, func(vault) {
	vault_name = maps.get(vault.values, "name", "")
	return vault_has_compliant_policy(vault_name, vault_policies)
})

generate_violation_message = func(vault) {
	vault_name = maps.get(vault.values, "name", "")
	return "Backup vault '" + vault.address + "' (name: " + vault_name + ") does not have a compliant resource-based policy. " +
		"Backup vault must have a resource-based policy with Deny statements for backup:DeleteRecoveryPoint, " +
		"backup:UpdateRecoveryPointLifecycle, and backup:PutBackupVaultAccessPolicy to prevent manual deletion of recovery points. " +
		"Refer to https://docs.aws.amazon.com/config/latest/developerguide/backup-recovery-point-manual-deletion-disabled.html for more details."
}

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
