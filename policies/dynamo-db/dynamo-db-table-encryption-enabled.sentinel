# This policy verifies that Amazon DynamoDB tables have encryption enabled
# to protect data at rest in accordance with AWS Audit Manager requirements.
# Refer to https://docs.aws.amazon.com/config/latest/developerguide/dynamodb-table-encryption-enabled.html for more details.

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps

# Constants
const = {
	"policy_name":                 "dynamo-db-table-encryption-enabled",
	"message":                     "DynamoDB table must have encryption enabled at rest",
	"resource_aws_dynamodb_table": "aws_dynamodb_table",
	"server_side_encryption":      "server_side_encryption",
	"enabled":                     "enabled",
}

# Functions
generate_violation_message = func(violation) {
	sse_blocks = maps.get(violation.values, const.server_side_encryption, [])

	if length(sse_blocks) is 0 {
		return "DynamoDB table '" + violation.address + "' relies on DynamoDB's default encryption at rest and is compliant. This message should not be emitted for compliant resources."
	}

	return "DynamoDB table '" + violation.address + "' must have encryption enabled. The 'enabled' attribute in the server_side_encryption block must be set to true"
}

is_encryption_enabled = func(res) {
	# Get server_side_encryption blocks (should be a list)
	sse_blocks = maps.get(res.values, const.server_side_encryption, [])

	# If no server_side_encryption block exists, DynamoDB uses default encryption (AWS owned key)
	# This is compliant as encryption is enabled by default
	if length(sse_blocks) is 0 {
		return true
	}

	# Check if the first server_side_encryption block has enabled set to true
	# Note: DynamoDB table typically has at most one server_side_encryption block
	sse_config = sse_blocks[0]

	# Within the block, Terraform requires `enabled`; treat only explicit true as compliant.
	enabled_value = maps.get(sse_config, const.enabled, false)
	return enabled_value is true
}

# Variables
resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_dynamodb_table).resources

violations = collection.reject(resources, func(res) {
	return is_encryption_enabled(res)
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
