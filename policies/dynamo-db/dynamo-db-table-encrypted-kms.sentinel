# This policy verifies that AWS DynamoDB tables are encrypted with AWS KMS.
# It checks the `server_side_encryption` block to ensure KMS encryption is enabled.
# Refer to https://docs.aws.amazon.com/config/latest/developerguide/dynamodb-table-encrypted-kms.html for more details.

# Copyright IBM Corp. 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports
import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps
import "strings"

# Params
# kmsKeyArns (Optional)
# Type: CSV
# Comma separated list of AWS KMS key ARNs allowed for encrypting Amazon DynamoDB Tables
param kmsKeyArns default ""

# Constants
const = {
	"policy_name":             "dynamo-db-table-encrypted-kms",
	"message":                 "DynamoDB table must have server-side encryption enabled with AWS KMS",
	"resource_dynamodb_table": "aws_dynamodb_table",
	"server_side_encryption":  "server_side_encryption",
	"enabled":                 "enabled",
	"kms_key_arn":             "kms_key_arn",
}

# Functions
# Parse comma-separated list of allowed KMS key ARNs
get_allowed_kms_keys = func() {
	if kmsKeyArns is "" {
		return []
	}

	# Split by comma and trim whitespace
	keys = strings.split(kmsKeyArns, ",")
	trimmed_keys = []
	for keys as key {
		trimmed = strings.trim_space(key)
		if trimmed is not "" {
			trimmed_keys = trimmed_keys + [trimmed]
		}
	}

	return trimmed_keys
}

# Check if a KMS key ARN is in the allowed list
is_kms_key_allowed = func(kms_key_arn) {
	allowed_keys = get_allowed_kms_keys()

	# If no specific keys are required, any KMS key is allowed
	if length(allowed_keys) is 0 {
		return true
	}

	# Check if the key is in the allowed list
	for allowed_keys as allowed {
		if kms_key_arn is allowed {
			return true
		}
	}

	return false
}

generate_violation_message = func(violation) {
	sse_blocks = maps.get(violation.values, const.server_side_encryption, [])
	allowed_keys = get_allowed_kms_keys()

	if length(sse_blocks) is 0 {
		if length(allowed_keys) > 0 {
			keys_list = strings.join(allowed_keys, ", ")
			return "DynamoDB table must have 'server_side_encryption.enabled' set to true and use one of the allowed KMS keys: " + keys_list + ""
		}
		return "DynamoDB table must have 'server_side_encryption.enabled' set to true so the table uses AWS KMS encryption instead of the default AWS-owned key"
	}

	sse = sse_blocks[0]
	enabled_value = maps.get(sse, const.enabled, false)
	kms_key_value = maps.get(sse, const.kms_key_arn, "")
	if kms_key_value is null {
		kms_key_value = ""
	}

	if enabled_value is false {
		return "DynamoDB table must have 'server_side_encryption.enabled' set to true to use AWS KMS encryption"
	}

	if length(allowed_keys) > 0 {
		keys_list = strings.join(allowed_keys, ", ")
		if kms_key_value is "" {
			return "DynamoDB table is encrypted with the default KMS-managed key, but the rule parameter 'kmsKeyArns' restricts encryption to these allowed keys: " + keys_list + ". Set 'kms_key_arn' to one of the allowed keys"
		}
		return "DynamoDB table is using KMS key '" + kms_key_value + "' which is not in the allowed list. Allowed keys: " + keys_list + ""
	}

	return "DynamoDB table must have 'server_side_encryption.enabled' set to true to use AWS KMS encryption"
}

is_kms_encrypted = func(res) {
	sse_blocks = maps.get(res.values, const.server_side_encryption, [])

	if length(sse_blocks) is 0 {
		return false
	}

	sse = sse_blocks[0]
	enabled_value = maps.get(sse, const.enabled, false)
	if enabled_value is false {
		return false
	}

	# Get KMS key ARN - treat null as empty string
	kms_key_value = maps.get(sse, const.kms_key_arn, "")
	if kms_key_value is null {
		kms_key_value = ""
	}

	# When no allowed list is supplied, enabled=true is sufficient. The provider
	# uses the default KMS-managed DynamoDB key when kms_key_arn is omitted.
	if length(get_allowed_kms_keys()) is 0 {
		return true
	}

	# When an allowed list is supplied, the configured kms_key_arn must be present
	# and must match one of the allowed keys.
	if kms_key_value is "" {
		return false
	}

	return is_kms_key_allowed(kms_key_value)
}

# Variables
resources = tf.plan(tfplan.planned_values.resources).type(const.resource_dynamodb_table).resources
violations = collection.reject(resources, func(res) {
	return is_kms_encrypted(res)
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        generate_violation_message(v),
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules
main = rule {
	violations is empty
}
